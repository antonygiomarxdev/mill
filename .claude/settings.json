{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".mill/checks/mill-role-guard --context",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".mill/checks/mill-role-guard --pretool",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
