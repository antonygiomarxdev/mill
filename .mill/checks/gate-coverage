#!/bin/bash
# Gate: IMPLEMENT phase complete — coverage must meet threshold
# Usage: gate-coverage [pkg]
#   pkg                     packages to test (default ./...)
# Env:   COVERAGE_THRESHOLD  minimum project coverage % (default 90)
# Exits 0 when project-wide statement coverage (go tool cover -func total) is
# >= COVERAGE_THRESHOLD, 1 otherwise.
set -euo pipefail
# Ratchet, not the target. COMMON.md states 90% as the standard; the project
# measures 83.6% today (the previous gate sampled one arbitrary package and
# reported a number that was never the project total). The threshold is set at
# the measured floor so the gate blocks regression immediately, and is raised
# toward 90 as coverage is added. Never lower this value. See #151.
threshold="${COVERAGE_THRESHOLD:-83}"
pkg="${1:-./...}"

# This gate is Go-specific and only meaningful where Go is the project
# language. A project without go.mod gets a clear message, not a failure:
# the coverage gate is part of the phase gauntlet, and a non-Go project's
# coverage is a matter for its own ecosystem's tooling.
if [[ ! -f go.mod ]]; then
    echo "mill: gate-coverage: no go.mod — not a Go project, skipping (language-agnostic gauntlet: see .mill/gauntlet)"
    exit 0
fi

# Project-wide coverage. `go test -coverprofile` accumulates every package into a
# single profile, and `go tool cover -func` reports its `total:` line — the
# aggregate statement coverage, which is the figure the threshold compares
# against. The total is an order-independent aggregate, so the verdict is
# identical across runs of the same tree. Sampling one per-package "coverage:"
# line was non-deterministic: `go test` reports packages in scheduling-
# dependent order, so `head -1` picked a different package each run.
# See docs/adr/0003-coverage-gate-total-not-sample.md
coverprofile="$(mktemp -t coverage.XXXXXX)"
trap 'rm -f "$coverprofile"' EXIT

output=$(go test -count=1 -coverprofile="$coverprofile" "$pkg" 2>&1) || {
  echo "BLOCKED: tests failed"
  echo "$output"
  exit 1
}

cov="$(go tool cover -func="$coverprofile" 2>/dev/null | grep '^total:' \
  | grep -oP '[0-9]+\.[0-9]+%' | head -1 | tr -d '%' || true)"
if [ -z "$cov" ]; then
  echo "BLOCKED: could not parse coverage total"
  echo "$output"
  exit 1
fi

# Compare with bc for floating point
if (( $(echo "$cov < $threshold" | bc -l) )); then
  echo "BLOCKED: coverage ${cov}% below threshold ${threshold}%"
  exit 1
fi

echo "COVERAGE gate passed: ${cov}% ≥ ${threshold}%"