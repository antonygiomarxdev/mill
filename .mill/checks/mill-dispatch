#!/usr/bin/env bash
# mill-dispatch — run the whole supervised dispatch loop as one command.
#
# The coordinator kept dropping steps: preflight, the task, the worker, the
# wait, and the release that may only follow a settled worker_done. This script
# sequences them so prose never has to. It is a thin sequence of existing
# `orca orchestration` subcommands (Orca's "Preferred Supervised Worker Loop");
# it reimplements none of Orca's behaviour.
#
#   mill-dispatch --brief <file> --role <role> --agent <agent> --name <slug> \
#       --title <title> [--writes <path>]... [--timeout-ms <n>]
#
# In order:
#   1. mill-preflight --brief <role> <paths...>   refuse a brief the role cannot write
#   2. read the agent catalog                     per-agent `submit: self|explicit`
#   3. orca orchestration task-create             record the brief as a task
#   4. orca orchestration worker-start            top-level worktree <slug>, repo default base
#   5. submit the brief if the agent needs it     empty enter, then confirm acceptance
#   6. orca orchestration check --wait            block for worker_done/escalation/question
#   7. report: dispatch id, worktree path, commits added — then stop
#   8. orca orchestration worker-release          ONLY after a settled worker_done
#
# It never merges, pushes, or verifies; verification and landing remain the
# coordinator's own steps. It never answers a question, never retries a failed
# start, and never releases a worker on a timeout, a question, an escalation, a
# heartbeat, or a stale worker_done. It never sends a stray enter to an agent
# that submits its own brief: the per-agent submit requirement is read from the
# catalog (`.mill/agents` or `.mill/agents.example`), never hardcoded here.
#
# A Run must already be bound to the invoking terminal (orca orchestration
# run-create / run-use, once, before the loop). This script does not create one.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
usage: mill-dispatch --brief <file> --role <role> --agent <agent> --name <slug> \
                     --title <title> [--writes <path>]... [--timeout-ms <n>]

Run the supervised dispatch loop end to end: preflight, create the task, start
the worker, wait for the dispatch to settle, report, then release the worker.

It does not verify or land. Verification and landing are the coordinator's own
steps, run separately after this script exits.

  --brief <file>     the brief to dispatch (read in as the task spec)
  --role <role>      the worker role; mill-preflight judges it against --writes
  --agent <agent>    the agent id passed to worker-start
  --name <slug>      the new top-level worktree name
  --title <title>    the task title
  --writes <path>    a path the brief asks the role to write; repeatable
  --timeout-ms <n>   wait window for check --wait (default 900000)
  -h, --help         this help
EOF
}

# --- options ---------------------------------------------------------------
brief=""
role=""
agent=""
slug=""
title=""
writes=()
timeout_ms=900000

while [[ $# -gt 0 ]]; do
    case "$1" in
        --brief)      brief="${2:-}"; shift 2 ;;
        --role)       role="${2:-}"; shift 2 ;;
        --agent)      agent="${2:-}"; shift 2 ;;
        --name)       slug="${2:-}"; shift 2 ;;
        --title)      title="${2:-}"; shift 2 ;;
        --writes)     writes+=("${2:-}"); shift 2 ;;
        --timeout-ms) timeout_ms="${2:-$timeout_ms}"; shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        *)            echo "mill-dispatch: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$brief" || -z "$role" || -z "$agent" || -z "$slug" || -z "$title" ]]; then
    echo "mill-dispatch: --brief, --role, --agent, --name and --title are all required" >&2
    usage >&2
    exit 2
fi
if [[ ! -f "$brief" ]]; then
    echo "mill-dispatch: brief not found: $brief" >&2
    exit 2
fi
if [[ ! "$timeout_ms" =~ ^[0-9]+$ ]]; then
    echo "mill-dispatch: --timeout-ms must be a non-negative integer" >&2
    exit 2
fi
# --- 0. Read the per-agent submit requirement from the catalog ----------------
# Whether a worker needs an explicit enter after worker-start pastes the brief
# is a property of the agent, and the fact lives in the catalog: `.mill/agents`
# (the local copy) or `.mill/agents.example` (tracked). Each agent entry
# carries a `submit:` marker — `self` submits its own injected brief,
# `explicit` leaves the brief pasted but unsubmitted and needs this script to
# send an empty enter. The list is deliberately NOT repeated here: a second
# copy would drift from the catalog, which is the defect this script once had.
catalog="$here/../agents"
if [[ ! -f "$catalog" ]]; then
    catalog="$here/../agents.example"
fi
if [[ ! -f "$catalog" ]]; then
    echo "mill-dispatch: agent catalog not found (looked for .mill/agents and .mill/agents.example)" >&2
    exit 2
fi
agent_entry="$(grep -m1 -F '`'"$agent"'`' "$catalog" || true)"
submit_marker="$(printf '%s' "$agent_entry" | grep -oE 'submit: (explicit|self)' | head -n1 | sed 's/^submit: //' || true)"
if [[ "$submit_marker" != "explicit" && "$submit_marker" != "self" ]]; then
    echo "mill-dispatch: no submit marker for agent '$agent' in $catalog" >&2
    echo "mill-dispatch: add \`submit: explicit\` (needs an enter) or \`submit: self\` (submits its own brief) to its entry" >&2
    exit 2
fi

# --- 1. Preflight: refuse before creating anything ---------------------------
# A path the role cannot write fails here, before any task or worktree exists,
# so a rejected brief never leaves an orphan task behind.
echo "mill-dispatch: preflight: $here/mill-preflight --brief $role ${writes[*]}"
if ! "$here/mill-preflight" --brief "$role" "${writes[@]}"; then
    echo "mill-dispatch: preflight rejected — no task created, nothing started" >&2
    exit 1
fi

# --- 2. Create the task from the brief file ---------------------------------
spec="$(<"$brief")"
echo "mill-dispatch: creating task: $title"
if ! task_json="$(orca orchestration task-create --spec "$spec" --task-title "$title" --json 2>/dev/null)"; then
    echo "mill-dispatch: task-create failed:" >&2
    printf '%s\n' "$task_json" >&2
    exit 1
fi
task_id="$(printf '%s' "$task_json" | jq -r '.result.task.id // .result.taskId // empty' 2>/dev/null || true)"
if [[ -z "$task_id" ]]; then
    echo "mill-dispatch: task-create returned no task id:" >&2
    printf '%s\n' "$task_json" >&2
    exit 1
fi
echo "mill-dispatch: task $task_id"

# --- 3. Start the worker on a new top-level worktree -------------------------
# --base-branch is deliberately omitted: Orca bases a new top-level worktree on
# the repo's default base, which is exactly "the current default branch head".
# A failed or unknown start exits non-zero; its receipt is parsed for the
# dispatch id and the failure signal instead of being dropped.
echo "mill-dispatch: starting worker (agent=$agent, worktree=$slug)"
start_json="$(orca orchestration worker-start \
        --task "$task_id" \
        --worktree new-top-level \
        --name "$slug" \
        --agent "$agent" \
        --setup run \
        --json 2>/dev/null)" || start_rc=$?
start_rc="${start_rc:-0}"

dispatch_id="$(printf '%s' "$start_json" | jq -r '.result.dispatchId // empty' 2>/dev/null || true)"
start_state="$(printf '%s' "$start_json" | jq -r '.result.state // empty' 2>/dev/null || true)"
start_last_error="$(printf '%s' "$start_json" | jq -r '.result.lastError // empty' 2>/dev/null || true)"

if [[ -z "$dispatch_id" ]]; then
    # No dispatch id at all: the RPC itself failed, nothing was started, and
    # there is nothing to submit or release. Surface and stop; never retry.
    echo "mill-dispatch: worker-start failed (no automatic retry); receipt:" >&2
    printf '%s\n' "$start_json" >&2
    exit 1
fi
worktree_effect="$(printf '%s' "$start_json" | jq -r '.result.effects[]? | select(.kind == "worktree") | .id' 2>/dev/null | sed -n '1p')"
worktree_path="${worktree_effect#*::}"
echo "mill-dispatch: dispatch $dispatch_id, worktree ${worktree_path:-<unresolved>}"

# --- 3b. Submit the brief for agents that need an explicit enter -------------
# Orca pastes the task spec into the agent's input and submits it. For some
# agents the submit does not take; Orca reports the start as failed with
# lastError "agent_prompt_stalled" — the brief is sitting in the input buffer,
# unsent. For those agents (catalog `submit: explicit`) an empty enter submits
# the buffered brief. Agents marked `submit: self` submit on their own; sending
# them an enter is a stray empty turn and is never done here.
if [[ "$start_state" != "ready" && "$start_last_error" == "agent_prompt_stalled" ]]; then
    if [[ "$submit_marker" != "explicit" ]]; then
        echo "mill-dispatch: worker-start: $start_state ($start_last_error) for agent '$agent' cataloged submit: $submit_marker — refusing to send a stray enter." >&2
        printf '%s\n' "$start_json" >&2
        exit 1
    fi
    echo "mill-dispatch: worker-start: $start_state ($start_last_error) — brief pasted but unsent"
    echo "mill-dispatch: submitting the brief for agent '$agent' (catalog submit: explicit)"

    # The agent terminal handle comes from worker-show, the documented owner
    # field; it is not guessed from the start receipt.
    show_json="$(orca orchestration worker-show --dispatch "$dispatch_id" --json 2>/dev/null || true)"
    agent_terminal="$(printf '%s' "$show_json" | jq -r '.result.worker.agent_terminal_handle // empty' 2>/dev/null || true)"
    if [[ -z "$agent_terminal" ]]; then
        echo "mill-dispatch: worker-show returned no agent terminal handle; cannot submit." >&2
        printf '%s\n' "$show_json" >&2
        exit 1
    fi

    send_json="$(orca terminal send --terminal "$agent_terminal" --enter --json 2>/dev/null)" || send_rc=$?
    send_rc="${send_rc:-0}"
    send_accepted="$(printf '%s' "$send_json" | jq -r '.result.send.accepted // empty' 2>/dev/null || true)"
    if [[ "$send_rc" -ne 0 || "$send_accepted" != "true" ]]; then
        echo "mill-dispatch: empty enter was NOT accepted (rc=$send_rc accepted=$send_accepted); not entering the wait." >&2
        printf '%s\n' "$send_json" >&2
        exit 1
    fi

    # Confirm acceptance before waiting: a wait that blocks on an unsubmitted
    # prompt is indistinguishable from a wait on a slow worker. worker-show
    # reports whether the terminal still resolves to the exact worker
    # (observation.exactWorker), whether it is live (observation.status), and
    # whether the worker is parked on a prompt only a human can answer
    # (observation.agentWait: absent = never evaluated, null = evaluated and
    # not waiting, object = waiting on a human).
    show_json="$(orca orchestration worker-show --dispatch "$dispatch_id" --json 2>/dev/null || true)"
    obs_status="$(printf '%s' "$show_json" | jq -r '.result.observation.status // empty' 2>/dev/null || true)"
    obs_exact="$(printf '%s' "$show_json" | jq -r '.result.observation.exactWorker // empty' 2>/dev/null || true)"
    if [[ "$obs_status" != "live" || "$obs_exact" != "true" ]]; then
        echo "mill-dispatch: cannot confirm acceptance: observation status=$obs_status exactWorker=$obs_exact." >&2
        printf '%s\n' "$show_json" >&2
        exit 1
    fi
    if ! printf '%s' "$show_json" | jq -e '.result.observation | has("agentWait")' >/dev/null 2>&1; then
        echo "mill-dispatch: cannot confirm acceptance: Orca did not evaluate the interactive wait; the enter is unverified." >&2
        printf '%s\n' "$show_json" >&2
        exit 1
    fi
    if [[ "$(printf '%s' "$show_json" | jq -r '.result.observation.agentWait' 2>/dev/null)" != "null" ]]; then
        wait_reason="$(printf '%s' "$show_json" | jq -r '.result.observation.agentWait.reason // "interactive prompt"' 2>/dev/null)"
        wait_source="$(printf '%s' "$show_json" | jq -r '.result.observation.agentWait.source // "unknown"' 2>/dev/null)"
        echo "mill-dispatch: worker is still waiting after submit ($wait_reason via $wait_source); NOT entering the wait." >&2
        printf '%s\n' "$show_json" >&2
        exit 1
    fi
    echo "mill-dispatch: enter accepted and confirmed (observation.status=$obs_status exactWorker=$obs_exact agentWait=null)"
elif [[ "$start_state" != "ready" ]]; then
    # --- 3c. Recognise a blocked worker instead of a generic failure ---------
    # Orca's worker-start waits for the agent TUI to reach tui-idle before it
    # declares the worker ready. A TUI parked on a blocking startup prompt
    # (workspace trust, hook review, update prompt, ...) never becomes idle;
    # Orca fails the start with lastError "Agent startup blocked: <reason>".
    # That is a stalled worker, not a slow one: name the reason and stop.
    # This script never answers such a prompt — the decision is the operator's,
    # not the script's.
    blocked_reason="$(printf '%s' "$start_last_error" \
        | sed -n 's/.*Agent startup blocked: \([^ ]*\).*/\1/p' | head -n1 || true)"
    if [[ -n "$blocked_reason" ]]; then
        if [[ "$blocked_reason" == "codex-trust-workspace" ]]; then
            # "codex-trust-workspace" is NOT a typo: Orca reuses the codex
            # label for any agent whose first launch parks on a workspace-trust
            # prompt, Cursor included. The prompt takes a bare key; --enter
            # would submit an empty line, so the command must not use it.
            echo "mill-dispatch: worker-start BLOCKED: workspace trust required (blockedReason=$blocked_reason)." >&2
            echo "mill-dispatch: the worker never reached its first turn — a stalled worker, not a slow one." >&2
            echo "mill-dispatch: trusting the workspace is the operator's security decision; this script will not answer." >&2
            echo "mill-dispatch: the operator sends the bare trust key (no --enter) to the worker terminal:" >&2
            echo "  orca terminal send --text 'a'" >&2
            echo "mill-dispatch: worker terminal handle: orca orchestration worker-show --dispatch $dispatch_id --json (worker.agent_terminal_handle)" >&2
            printf '%s\n' "$start_json" >&2
            exit 1
        fi
        echo "mill-dispatch: worker-start BLOCKED (blockedReason=$blocked_reason); not entering the wait." >&2
        printf '%s\n' "$start_json" >&2
        exit 1
    fi
    # Any other non-ready start is a genuine failure (worktree create, terminal
    # create, agent readiness, setup, an unknown outcome). Surface the receipt
    # and stop; never auto-retry and never send an enter to a worker that
    # never got a pasted brief.
    echo "mill-dispatch: worker-start failed (no automatic retry); receipt:" >&2
    printf '%s\n' "$start_json" >&2
    exit 1
fi

# --- 4. Wait for the dispatch to settle --------------------------------------
# Orca's blocking wait, not a poll loop and not a TUI read. Keepalive lines go
# to stderr and are discarded; stdout is the Delivery JSON.
#
# The wait is bounded by a single deadline computed ONCE from --timeout-ms,
# before the first check --wait. Each check --wait is capped at the time
# remaining to that deadline, never the full timeout. The loop ends on exactly
# three things: a settled worker_done for THIS dispatch, a question or
# escalation (both stop today and keep stopping), or the deadline being spent.
#
# A stale worker_done — one that belongs to an earlier dispatch, not this one
# — must NOT end the wait. check --wait returns the bound Run's oldest
# unacknowledged delivery, so a stale worker_done can arrive before the live
# one. The old code treated any non-settling first delivery as failure and
# exited, abandoning the live worker (#191). We now ignore a worker_done that is
# not ours and keep waiting until the real one arrives or the deadline is spent.
#
# Why the loop does not treat a zero-count return as the end of the wait:
# check --wait returns count 0 only when its requested window elapses (the
# server-side waiter holds the connection open until --timeout-ms expires — see
# the CLI's message-check-handler + transport: a single RPC, the socket held
# for the full window, _keepalive frames only refresh the idle timer and never
# settle the request). Even so, the loop keys off the wall-clock deadline
# below, not the count, so a zero-count return that ever came back early would
# simply wait again with the leftover budget. The deadline is the sole source
# of truth for "time is up".
#
# Why this matters to the coordinator: the loop's exit is authoritative, and
# terminal output going quiet is NOT evidence either way. A frozen wait and a
# finished worker look identical from outside — both stop writing to the
# terminal. The only reliable signal that a dispatch has settled is this loop
# exiting on a worker_done for the right dispatch; silence alone cannot
# distinguish "still working" from "dead", and acting on it cost real time.
echo "mill-dispatch: waiting for dispatch $dispatch_id to settle (timeout ${timeout_ms} ms)"
deadline_ms=$(( $(date +%s%3N) + timeout_ms ))
settled=0
while true; do
    remaining_ms=$(( deadline_ms - $(date +%s%3N) ))
    if [[ "$remaining_ms" -le 0 ]]; then
        echo "mill-dispatch: wait deadline spent for dispatch $dispatch_id." >&2
        break
    fi

    delivery="$(orca orchestration check --wait --types worker_done,escalation,question --timeout-ms "$remaining_ms" --json 2>/dev/null || true)"

    count="$(printf '%s' "$delivery" | jq -r '.result.count // 0' 2>/dev/null || true)"
    if [[ -z "$delivery" ]] || [[ ! "$count" =~ ^[0-9]+$ ]] || [[ "$count" -le 0 ]]; then
        # Nothing to process this iteration: either the window elapsed (count 0,
        # the common case) or the call came back empty/unparseable. A
        # zero-count return never ends the loop on its own — only the
        # wall-clock deadline above does. If the window truly elapsed, the next
        # pass's remaining_ms is ~0 and we break; if the call returned early we
        # simply wait again with the time still left. Either way we never exit
        # here, so a stale worker_done arriving first cannot end the wait.
        continue
    fi

    # Process every message in full. Only a settled worker_done for THIS
    # dispatch authorises release; question and escalation both exit, and a
    # stale worker_done is ignored so the loop keeps waiting for the real one.
    while IFS= read -r msg; do
        [[ -z "$msg" ]] && continue
        mtype="$(printf '%s' "$msg" | jq -r '.type // empty' 2>/dev/null || true)"
        mid="$(printf '%s' "$msg" | jq -r '.id // empty' 2>/dev/null || true)"
        msubj="$(printf '%s' "$msg" | jq -r '.subject // empty' 2>/dev/null || true)"
        mbody="$(printf '%s' "$msg" | jq -r '.body // empty' 2>/dev/null || true)"

        case "$mtype" in
            question)
                # An unanswered question kills itself when the dispatch settles.
                # Stop loudly, print the body verbatim, and never answer on the
                # coordinator's behalf.
                echo "mill-dispatch: WORKER ASKED A QUESTION — dispatch $dispatch_id will not settle until it is answered." >&2
                echo "question id: $mid" >&2
                echo "--- question body (verbatim) ---" >&2
                printf '%s\n' "$mbody" >&2
                echo "--- end question body ---" >&2
                echo "mill-dispatch: answer with: orca orchestration reply --id $mid --body '<answer>'" >&2
                echo "mill-dispatch: worker NOT released." >&2
                exit 1
                ;;
            escalation)
                echo "mill-dispatch: WORKER ESCALATED — surfacing in full; worker NOT released." >&2
                echo "escalation id: $mid" >&2
                printf '%s\n' "$msubj" >&2
                printf '%s\n' "$mbody" >&2
                exit 1
                ;;
            worker_done)
                wd_dispatch="$(printf '%s' "$msg" | jq -r 'try (.payload | fromjson | .dispatchId) catch empty' 2>/dev/null || true)"
                wd_task="$(printf '%s' "$msg" | jq -r 'try (.payload | fromjson | .taskId) catch empty' 2>/dev/null || true)"
                wd_outcome="$(printf '%s' "$msg" | jq -r 'try (.payload | fromjson | .outcome) catch empty' 2>/dev/null || true)"
                if [[ "$wd_dispatch" == "$dispatch_id" && "$wd_task" == "$task_id" ]]; then
                    # A worker_done for this task + dispatch marks it settled,
                    # whether the outcome succeeded or failed. This is the one
                    # and only message that authorises the release below.
                    echo "mill-dispatch: settled worker_done for dispatch $dispatch_id (outcome=$wd_outcome)"
                    printf '%s\n' "$msubj" "$mbody"
                    settled=1
                else
                    # Stale or rejected worker_done: not this dispatch. Surface it,
                    # never release on it, and keep waiting — exiting here is the
                    # bug this loop fixes (#191).
                    echo "mill-dispatch: ignoring stale worker_done (task=$wd_task dispatch=$wd_dispatch) — not this dispatch" >&2
                    printf '%s\n' "$msubj" "$mbody" >&2
                fi
                ;;
            *)
                # heartbeat/status/etc: surface in full, but never a release signal.
                echo "mill-dispatch: [$mtype] $msubj" >&2
                [[ -n "$mbody" ]] && printf '%s\n' "$mbody" >&2
                ;;
        esac
    done <<< "$(printf '%s' "$delivery" | jq -c '.result.messages[]?')"

    if [[ "$settled" -eq 1 ]]; then
        break
    fi
done

if [[ "$settled" -ne 1 ]]; then
    echo "mill-dispatch: no settled worker_done for dispatch $dispatch_id; worker NOT released." >&2
    echo "mill-dispatch: inspect with: orca orchestration worker-show --dispatch $dispatch_id" >&2
    exit 1
fi

# --- 5. Report and stop ------------------------------------------------------
# Print what the coordinator needs next, then stop: this script never merges,
# pushes, or verifies.
echo
echo "mill-dispatch: dispatch settled."
echo "  dispatch id : $dispatch_id"
echo "  task id     : $task_id"
echo "  worktree    : ${worktree_path:-<unresolved>}"
if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    echo "  commits added on the branch:"
    base="$(git -C "$worktree_path" reflog --format=%H 2>/dev/null | tail -n 1 || true)"
    if [[ -n "$base" && "$(git -C "$worktree_path" cat-file -t "$base" 2>/dev/null)" == "commit" ]]; then
        git -C "$worktree_path" log --oneline "${base}..HEAD" 2>/dev/null || true
    else
        git -C "$worktree_path" log --oneline -10 2>/dev/null || true
    fi
fi

# --- 6. Release the worker — only now, after a settled worker_done ----------
# Orca RPC errors are JSON on stdout (ok:false); stderr is discarded so the
# receipt below is always parseable.
echo "mill-dispatch: releasing worker for dispatch $dispatch_id"
if release_out="$(orca orchestration worker-release --dispatch "$dispatch_id" --json 2>/dev/null)"; then
    release_rc=0
else
    release_rc=$?
fi
printf '%s\n' "$release_out"
rel_state="$(printf '%s' "$release_out" | jq -r '.result.state // .result.status // .result.outcome // empty' 2>/dev/null || true)"
rel_recovery="$(printf '%s' "$release_out" | jq -r '.result.recovery // .result.recoveryAction // .recovery // (.error.data.nextCommandArgs | join(" ")) // empty' 2>/dev/null || true)"

if [[ "$release_rc" -ne 0 || "$rel_state" == "release_unknown" ]]; then
    echo "mill-dispatch: worker-release not clean (rc=$release_rc state=$rel_state)." >&2
    [[ -n "$rel_recovery" ]] && echo "mill-dispatch: recovery action from the receipt: $rel_recovery" >&2
    echo "mill-dispatch: do NOT substitute any other command." >&2
    exit 1
fi
if [[ "$rel_state" == "release_pending" ]]; then
    echo "mill-dispatch: release pending — follow the recovery action in the receipt above; do NOT substitute any other command." >&2
    [[ -n "$rel_recovery" ]] && echo "mill-dispatch: recovery action: $rel_recovery" >&2
else
    echo "mill-dispatch: worker released ($rel_state)."
fi

exit 0
