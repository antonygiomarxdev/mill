#!/usr/bin/env bash
# mill-install — install Mill into the current project without destroying what
# is already there. Non-destructive by construction: nothing that exists is
# overwritten, every change is recorded in .mill/install.json, and
# mill-uninstall reverses it.
#
#   mill-install <scaffold-dir>              — install (no git hooks)
#   mill-install <scaffold-dir> --with-hooks — also point git's core.hooksPath
#                                              at .mill/checks, only when the
#                                              project has no hooks configured.
#
# Mill's gates do not run from git hooks (see ADR 0009). The coordinator runs
# .mill/checks/mill-verify against a worker's worktree after every dispatch;
# the project's own hooks stay the project's. core.hooksPath is adopted only
# when a project explicitly asks for it AND has no value to displace.
#
# Validation happens before any copy: if any precondition fails, nothing has
# been changed.
#
# Steps:
#   1. Validate: git repo, scaffold has .mill/, skill source present.
#   2. Copy .mill/ and checks/ from the scaffold (additive; Mill owns .mill/).
#   3. Optionally (--with-hooks) adopt core.hooksPath — only if unset. Never
#      chain, never overwrite, never replace: git holds one value.
#   4. Link the skill into .claude/skills/using-mill/ — create the directory if
#      needed, refuse if something is already there, never overwrite.
#   5. Write .mill/install.json so mill-uninstall can undo all of it.
#
# Re-running on an already-installed project is a no-op that says so.
set -euo pipefail

scaffold="${1:-}"
with_hooks=0
if [[ "${2:-}" == "--with-hooks" ]]; then
    with_hooks=1
fi

if [[ -z "$scaffold" || ! -d "$scaffold/.mill" ]]; then
    echo "usage: mill-install <scaffold-dir> [--with-hooks]" >&2
    echo "  <scaffold-dir> is a Mill scaffold (contains .mill/ and checks/)" >&2
    echo "  --with-hooks also adopts git's hooks pointer (core.hooksPath -> .mill/checks)," >&2
    echo "              only when no hooks are configured. Mill's gates run from the" >&2
    echo "              dispatch boundary (mill-verify), not from git hooks (ADR 0009)." >&2
    exit 2
fi

# --- 1. Validate before copying anything -------------------------------------
# Every precondition below must pass before a single file is copied. A failed
# install prints "Nothing has been changed." and it is true.

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: not a git repository. Run this inside the project to install into." >&2
    exit 1
fi

if [[ ! -f "$scaffold/.mill/skills/using-mill.md" ]]; then
    echo "error: $scaffold/.mill/skills/using-mill.md is missing from the scaffold" >&2
    exit 1
fi

if [[ "$with_hooks" -eq 1 ]]; then
    current="$(git config --get core.hooksPath 2>/dev/null || true)"
    if [[ -n "$current" ]]; then
        echo "error: this project already has git hooks configured (core.hooksPath='$current')." >&2
        echo "  Mill's gates do not run from git hooks (ADR 0009) and will not replace yours." >&2
        echo "  Nothing has been changed." >&2
        exit 1
    fi
fi

top="$(git rev-parse --show-toplevel)"
cd "$top"

MANIFEST=".mill/install.json"
CHANGES=0

echo "mill: installing into $top"

# --- 2. Copy the policy directory and the gates ------------------------------
# Additive: everything copied lands under .mill/ or checks/, both Mill's own.
cp -r "$scaffold/.mill" .
cp -r "$scaffold/checks" .
chmod +x .mill/checks/* checks/* 2>/dev/null || true

# --- 3. Hooks — opt-in only, and only when nothing is configured -------------
# The pre-set value is the undo record: capture it before any mutation and
# write it to the manifest, so mill-uninstall restores what was there before
# Mill, not what Mill set.
previous="$(git config --get core.hooksPath 2>/dev/null || true)"
if [[ "$with_hooks" -eq 1 ]]; then
    mill_hooks=".mill/checks"
    if [[ -z "$previous" ]]; then
        git config core.hooksPath "$mill_hooks"
        echo "mill: git now runs the gauntlet from $mill_hooks (core.hooksPath)"
        CHANGES=1
    elif [[ "$previous" == "$mill_hooks" ]]; then
        echo "mill: core.hooksPath already points at $mill_hooks — nothing to do"
    else
        # Validated above; this branch is unreachable in practice.
        echo "error: core.hooksPath is set to '$previous'; refusing to replace it." >&2
        echo "  Mill never chains and never replaces: git holds one value." >&2
        exit 1
    fi
else
    echo "mill: no hooks installed. Mill's gates run from the dispatch boundary:"
    echo "  mill-verify --worktree <path> --role <role> --files-modified <list>"
    echo "  (see .mill/checks/mill-verify and ADR 0009). Add --with-hooks to also"
    echo "  adopt core.hooksPath, only when the project has no hooks configured."
fi

# --- 4. Skill — install beside, never overwrite ------------------------------
skill_link=".claude/skills/using-mill/SKILL.md"
skill_source=".mill/skills/using-mill.md"

if [[ ! -f "$skill_source" ]]; then
    echo "error: $skill_source is missing from the scaffold — nothing to link" >&2
    exit 1
fi

if [[ -L "$skill_link" ]]; then
    target="$(readlink "$skill_link")"
    if [[ "$target" == *".mill/skills/using-mill.md" ]]; then
        echo "mill: skill already linked ($skill_link -> $target) — nothing to do"
    else
        echo "error: $skill_link already exists and points elsewhere -> $target" >&2
        echo "  Mill will NOT overwrite it. Nothing has been changed." >&2
        echo "  Remove it first if you want Mill's link: rm $skill_link" >&2
        exit 1
    fi
elif [[ -e "$skill_link" ]]; then
    echo "error: $skill_link already exists and is not a symlink." >&2
    echo "  Mill will NOT overwrite it. Nothing has been changed." >&2
    echo "  Move it aside first if you want Mill's link." >&2
    exit 1
else
    mkdir -p "$(dirname "$skill_link")"
    # Relative target: from .claude/skills/using-mill/ up to the repo root.
    ln -s "../../../$skill_source" "$skill_link"
    echo "mill: linked $skill_link -> ../../../$skill_source"
    CHANGES=1
fi

# --- 5. Manifest — the undo record -------------------------------------------
if [[ "$CHANGES" -eq 0 ]]; then
    echo "mill: nothing to change — Mill is already installed"
    exit 0
fi

mkdir -p .mill
{
    echo "{"
    echo "  \"previousHooksPath\": \"$previous\","
    echo "  \"skillLink\": \"$skill_link\","
    echo "  \"installedAt\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
    echo "}"
} > "$MANIFEST"
echo "mill: wrote $MANIFEST"

echo "mill: install complete. Undo with: mill-uninstall"