#!/usr/bin/env bash
# mill-install — install Mill into the current project without destroying what
# is already there. Non-destructive by construction: nothing that exists is
# overwritten, every change is recorded in .mill/install.json, and
# mill-uninstall reverses it.
#
#   mill-install <scaffold-dir>              — install (refuse if hooks exist)
#   mill-install <scaffold-dir> --replace-hooks
#                                            — adopt git's hooks pointer even if
#                                              the project has one, recording
#                                              the previous value for undo. The
#                                              old hook files stay on disk.
#
# Steps:
#   1. Copy .mill/ and checks/ from the scaffold (additive; Mill owns .mill/).
#   2. Adopt core.hooksPath — refuse by default if the project already has one
#      set to something else; with --replace-hooks, record the previous value
#      in the manifest and take over. Never chain: git holds one value.
#   3. Link the skill into .claude/skills/using-mill/ — create the directory if
#      needed, refuse if something is already there, never overwrite.
#   4. Write .mill/install.json so mill-uninstall can undo all of it.
#
# Re-running on an already-installed project is a no-op that says so.
set -euo pipefail

scaffold="${1:-}"
replace_hooks=0
if [[ "${2:-}" == "--replace-hooks" ]]; then
    replace_hooks=1
fi

if [[ -z "$scaffold" || ! -d "$scaffold/.mill" ]]; then
    echo "usage: mill-install <scaffold-dir> [--replace-hooks]" >&2
    echo "  <scaffold-dir> is a Mill scaffold (contains .mill/ and checks/)" >&2
    echo "  --replace-hooks adopts git's hooks pointer even if one is set," >&2
    echo "                 recording the previous value for mill-uninstall" >&2
    exit 2
fi

# Refuse to run outside a git repository — hooks are a git feature.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: not a git repository. Mill's gates are git hooks; run this in a repo." >&2
    exit 1
fi

top="$(git rev-parse --show-toplevel)"
cd "$top"

MANIFEST=".mill/install.json"
CHANGES=0

echo "mill: installing into $top"

# --- 1. Copy the policy directory and the gates -----------------------------
# Additive: everything copied lands under .mill/ or checks/, both Mill's own.
cp -r "$scaffold/.mill" .
cp -r "$scaffold/checks" .
chmod +x .mill/checks/* checks/* 2>/dev/null || true

# --- 2. Hooks — adopt core.hooksPath, never chain, refuse by default ---------
# Capture the pre-install value before any mutation: it is the undo record.
previous="$(git config --get core.hooksPath 2>/dev/null || true)"
current="$previous"
mill_hooks=".mill/checks"

if [[ -z "$current" ]]; then
    git config core.hooksPath "$mill_hooks"
    echo "mill: git now runs the gauntlet from $mill_hooks (core.hooksPath)"
    CHANGES=1
elif [[ "$current" == "$mill_hooks" ]]; then
    echo "mill: core.hooksPath already points at $mill_hooks — nothing to do"
elif [[ "$replace_hooks" -eq 1 ]]; then
    # Explicit confirmation. The previous value is recorded in the manifest,
    # the old hook files stay on disk, and mill-uninstall restores the value.
    git config core.hooksPath "$mill_hooks"
    echo "mill: replaced core.hooksPath '$current' -> '$mill_hooks' (recorded for undo)"
    echo "mill: your old hooks at '$current' were NOT deleted — they are simply no"
    echo "mill: longer run by git. Restore them any time with: mill-uninstall"
    CHANGES=1
else
    echo "error: this project already has git hooks configured (core.hooksPath='$current')." >&2
    echo "  Mill will NOT replace them. Nothing has been changed." >&2
    echo "  Decide how to proceed:" >&2
    echo "    - keep your current hooks and skip Mill's gate hooks:" >&2
    echo "        git config core.hooksPath '$current'   # already the case" >&2
    echo "    - let Mill's gauntlet take over (your old hooks stop running, but" >&2
    echo "      are not deleted; the previous path is saved for undo):" >&2
    echo "        mill-install <scaffold-dir> --replace-hooks" >&2
    echo "  Re-run mill-install after deciding. The skill link step below was" >&2
    echo "  skipped; your existing hooks were not touched." >&2
    exit 1
fi

# --- 3. Skill — install beside, never overwrite ------------------------------
skill_link=".claude/skills/using-mill/SKILL.md"
skill_source=".mill/skills/using-mill.md"

if [[ ! -f "$skill_source" ]]; then
    echo "error: $skill_source is missing from the scaffold — nothing to link" >&2
    exit 1
fi

if [[ -L "$skill_link" ]]; then
    target="$(readlink "$skill_link")"
    if [[ "$target" == *".mill/skills/using-mill.md" ]]; then
        echo "mill: skill already linked ($skill_link -> $target) — nothing to do"
    else
        echo "error: $skill_link already exists and points elsewhere -> $target" >&2
        echo "  Mill will NOT overwrite it. Nothing has been changed." >&2
        echo "  Remove it first if you want Mill's link: rm $skill_link" >&2
        exit 1
    fi
elif [[ -e "$skill_link" ]]; then
    echo "error: $skill_link already exists and is not a symlink." >&2
    echo "  Mill will NOT overwrite it. Nothing has been changed." >&2
    echo "  Move it aside first if you want Mill's link." >&2
    exit 1
else
    mkdir -p "$(dirname "$skill_link")"
    # Relative target: from .claude/skills/using-mill/ up to the repo root.
    ln -s "../../../$skill_source" "$skill_link"
    echo "mill: linked $skill_link -> ../../../$skill_source"
    CHANGES=1
fi

# --- 4. Manifest — the undo record -------------------------------------------
if [[ "$CHANGES" -eq 0 ]]; then
    echo "mill: nothing to change — Mill is already installed"
    exit 0
fi

mkdir -p .mill
{
    echo "{"
    echo "  \"previousHooksPath\": \"$previous\","
    echo "  \"skillLink\": \"$skill_link\","
    echo "  \"installedAt\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
    echo "}"
} > "$MANIFEST"
echo "mill: wrote $MANIFEST"

echo "mill: install complete. Undo with: mill-uninstall"
