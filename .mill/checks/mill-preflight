#!/usr/bin/env bash
# mill-preflight — refuse to dispatch when Mill cannot.
# Called by the coordinator before any dispatch. Exits non-zero with an
# actionable message when Orca's runtime is unreachable, or the working
# directory is not a git work tree or a Mill project.
#
# Optional brief check:
#   mill-preflight [--project-root <path>] --brief <role> <path> [<path> ...]
#
# With --brief, after the environment checks below, every named path is
# judged against <role>'s allowed_files (via role-enforce --test). The
# role-capabilities map role-enforce reads comes from the project root —
# --project-root when given, the current directory otherwise (this script
# runs before any worktree exists, so the working directory is the project).
# A path the role may not write fails the preflight, and the roles that can
# write it are named so the coordinator can route the work instead of
# guessing. With no --brief, behaviour is exactly the environment checks
# below.
set -euo pipefail

# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

# --- argument parsing --------------------------------------------------------
brief_mode=0
brief_role=""
brief_paths=()
project_root=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --project-root)
            project_root="${2:-}"
            shift 2
            ;;
        --project-root=*)
            project_root="${1#--project-root=}"
            shift
            ;;
        --brief)
            brief_mode=1
            brief_role="${2:-}"
            shift 2
            ;;
        -h|--help)
            echo "usage: mill-preflight [--project-root <path>] [--brief <role> <path> [<path>...]]"
            echo "  (no arguments)              check Orca reachability, git work tree, and Mill project layout"
            echo "  --project-root <path>       project root supplying .mill/role-capabilities"
            echo "                               (--brief only); defaults to the current directory"
            echo "  --brief <role> <path>...     refuse every path <role> cannot write, naming"
            echo "                               the role(s) that can write each one"
            exit 0
            ;;
        -*)
            echo "error: unknown argument: $1" >&2
            exit 2
            ;;
        *)
            # Positional arguments only have meaning after --brief (they are the
            # paths). Outside --brief there was historically no argument
            # handling, so ignore them.
            if [[ "$brief_mode" -eq 1 ]]; then
                brief_paths+=("$1")
            fi
            shift
            ;;
    esac
done

# 1. Resolve the Orca CLI executable and refuse the screen reader --------------
# Resolve before the reachability check so the refusal can name the path we
# actually tried. Step 5 of the resolution rule (see common.sh) is not optional:
# whatever branch was taken, if the resolved executable's first two bytes are
# `#!` rather than the ELF magic, it is the screen reader — refuse, loudly,
# naming the path and the fix.
resolve_orca

orca_path="$(command -v "$ORCA_CLI" 2>/dev/null || true)"
if [[ -z "$orca_path" ]]; then
    echo "error: '$ORCA_CLI' not found on PATH — cannot reach Orca." >&2
    echo "  resolve order: \$ORCA_CLI_COMMAND, then orca-dev (when \$ORCA_DEV_REPO_ROOT is set), then orca-ide on Linux outside an Orca terminal, then orca." >&2
    echo "  fix: set ORCA_CLI_COMMAND to the absolute path of your Orca CLI, e.g. export ORCA_CLI_COMMAND=/home/ksante/.local/bin/orca" >&2
    exit 1
fi
if [[ -f "$orca_path" ]] && head -c 2 "$orca_path" | grep -qFx '#!'; then
    echo "error: '$ORCA_CLI' resolves to '$orca_path', which is a script (begins with '#!')." >&2
    echo "  on Linux this is the GNOME Orca screen reader, not the Orca CLI." >&2
    echo "  the wrong executable won because \$PATH orders '$orca_path' ahead of the real one." >&2
    echo "  fix: set ORCA_CLI_COMMAND to the absolute path of your Orca CLI, e.g. export ORCA_CLI_COMMAND=/home/ksante/.local/bin/orca" >&2
    exit 1
fi

# 2. Orca must be reachable
if ! $ORCA_CLI status 2>/dev/null | grep -q "runtimeReachable: true"; then
    echo "error: Orca is not running. Run '$ORCA_CLI open' first." >&2
    exit 1
fi

# 3. Must be inside a git work tree.
# This is a working-directory check, like the .mill/roles layout check below:
# it judges the tree the coordinator is dispatching from, so it reads the
# working directory — never mill_root. The role-definition reads in the
# --brief branch below resolve from mill_root for a different reason: a
# role's ROLE.md is authority about the role, and that authority comes from
# the repository this script lives in, not from wherever it was invoked.
# After ADR 0014 those are two distinct roots; judging this one by mill_root
# would be issue #195 from the other side.
#
# A linked worktree is a real checkout and passes: the command below prints
# 'true' there. A bare repository prints 'false' (exit 0) and a directory
# outside any repository makes the command fail; both are refused. A bare
# repository must not pass silently — issue #148 is an agent setting
# core.bare=true and breaking a checkout.
if [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]]; then
    echo "error: Not inside a git work tree (a bare repository is not a checkout). Run 'git init' (or 'git clone') here first." >&2
    exit 1
fi

# 4. Must be in a Mill project
# This is a working-directory layout check, not a role-definition read: it
# only asks whether the caller is inside a Mill project. The role definitions
# that decide what a role may write resolve from mill_root in the --brief
# branch below, never from this directory.
if [[ ! -d .mill/roles ]]; then
    echo "error: Not a Mill project (no .mill/roles/)." >&2
    exit 1
fi

# 5. --brief: the named role must be able to write every named path.
if [[ "$brief_mode" -eq 1 ]]; then
    if [[ -z "$brief_role" ]]; then
        echo "error: --brief requires a role" >&2
        exit 2
    fi
    if [[ ${#brief_paths[@]} -eq 0 ]]; then
        echo "error: --brief requires at least one path" >&2
        exit 2
    fi
    # The role definitions resolve from the coordinator's Mill root — this
    # script's own location — never from the caller's working directory. A
    # role's ROLE.md decides what that role may write, so it must come from
    # the repository the checks live in, not from wherever this was invoked.
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    mill_root="$(cd "$here/../.." && pwd)"
    roles_dir="$mill_root/.mill/roles"
    role_enforce="$here/role-enforce"
    if [[ ! -x "$role_enforce" ]]; then
        echo "error: role-enforce not found next to mill-preflight" >&2
        exit 1
    fi

    # The project root supplies .mill/role-capabilities (via role-enforce).
    # It defaults to the current directory because mill-preflight runs in the
    # project root BEFORE any dispatch, when no worktree exists yet — this
    # directory is the project, not a tree under judgement, so reading the
    # capability map from it does not violate the ADR 0014 rule. An explicit
    # --project-root overrides the default (e.g. a real install where the
    # caller is not inside the project). role-enforce itself still receives
    # the root explicitly and never infers it.
    if [[ -n "$project_root" ]]; then
        if [[ ! -d "$project_root" ]]; then
            echo "error: no such project root: $project_root" >&2
            exit 1
        fi
        project_root="$(cd "$project_root" && pwd -P)"
    else
        project_root="$(pwd -P)"
    fi

    if [[ ! -f "$roles_dir/$brief_role/ROLE.md" ]]; then
        echo "error: unknown role '$brief_role' (no $roles_dir/$brief_role/ROLE.md)" >&2
        exit 2
    fi

    # The roles that can write a path are found by asking role-enforce the same
    # question for every other role. This reuses role-enforce's exact extension
    # and basename classification, so the owner answer cannot drift from the
    # gate that enforces it. A role directory with no ROLE.md is skipped.
    determine_owners() {
        local path="$1" role_dir role owners=""
        for role_dir in "$roles_dir"/*/; do
            [[ -d "$role_dir" && -f "$role_dir/ROLE.md" ]] || continue
            role="$(basename "$role_dir")"
            if "$role_enforce" --test "$role" --project-root "$project_root" "$path" >/dev/null 2>&1; then
                owners="${owners}${owners:+, }$role"
            fi
        done
        printf '%s' "$owners"
    }

    failed=0
    for path in "${brief_paths[@]}"; do
        if ! "$role_enforce" --test "$brief_role" --project-root "$project_root" "$path" >/dev/null 2>&1; then
            owners="$(determine_owners "$path")"
            if [[ -z "$owners" ]]; then
                echo "mill-preflight: '$path' is not allowed for role '$brief_role' (no role can write it; cannot determine an owner)" >&2
            else
                echo "mill-preflight: '$path' is not allowed for role '$brief_role'; it can be written by: $owners" >&2
            fi
            failed=1
            printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" preflight "$brief_role" "$path" >> "$here/../rejections.log" 2>/dev/null || true
        fi
    done
    exit "$failed"
fi

# Load Orca's coordination guide before relying on its surface.
echo "Orca's coordination guide: load with '$ORCA_CLI skills get orca-cli' and '$ORCA_CLI skills get orchestration'"
exit 0
