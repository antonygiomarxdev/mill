#!/usr/bin/env bash
# mill-verify — verify a worker's output against its role and the gauntlet.
# The single verification entry point at the dispatch boundary. Invoked by the
# coordinator after worker_done, in the worker's own worktree:
#
#   mill-verify --worktree <path> --role <role> --project-root <path> [--files-modified <a,b,c>]
#
# --project-root is required and must NOT be the worktree. It names the
# project whose .mill/role-capabilities and .mill/gauntlet judge the worktree.
# This script is the caller that enters the worktree, so it resolves the
# project root BEFORE cd'ing into the tree under judgement and passes it down
# (ADR 0014, #194); when both resolve to the same tree it refuses — a worker
# whose output is judged by the file that governs its own permissions defeats
# the gate (#195).
#
# What it checks, in order:
#   1. The gauntlet — build and lint (pre-commit steps) and test (pre-push
#      step). The config is read from the project root's .mill/gauntlet; the
#      commands run inside the worktree, so they check exactly what the worker
#      produced.
#   2. Role capability enforcement — every changed file must be allowed for
#      the dispatched role. The change set is --files-modified when given
#      (the worker_done payload is the authoritative record), otherwise the
#      git diff since the worktree's base commit.
#   3. Nothing may be left uncommitted — a worker whose deliverable is not
#      committed cannot pass.
#
# Exits 0 if clean; 1 naming the failure otherwise. This is not a git hook:
# it is a command the coordinator runs, so it cannot be skipped by a worker.
set -euo pipefail

worktree=""
role=""
project_root=""
files_modified=""
dispatch=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --worktree) worktree="${2:-}"; shift 2 ;;
        --role) role="${2:-}"; shift 2 ;;
        --project-root) project_root="${2:-}"; shift 2 ;;
        --files-modified) files_modified="${2:-}"; shift 2 ;;
        --dispatch) dispatch="${2:-}"; shift 2 ;;
        -h|--help)
            echo "usage: mill-verify --worktree <path> --role <role> --project-root <path> [--files-modified <a,b,c>] [--dispatch <ctx_id>]"
            echo "  --worktree <path>       the worker's worktree (the tree under judgement)"
            echo "  --role <role>           the dispatched role (its ROLE.md in .mill/roles/)"
            echo "  --project-root <path>   the project root; supplies .mill/role-capabilities and"
            echo "                          .mill/gauntlet. Required, and must not be the worktree —"
            echo "                          a run whose project root equals the judged worktree is"
            echo "                          refused (ADR 0014)"
            echo "  --files-modified <list> the worker_done change set; judged instead of the"
            echo "                          git diff since the worktree base commit"
            echo "  --dispatch <ctx_id>     before the gauntlet, print that dispatch's mailbox"
            echo "                          messages; an unanswered question is a hard failure,"
            echo "                          a missing worker_done is only a warning"
            exit 0
            ;;
        *) echo "error: unknown argument: $1" >&2; exit 2 ;;
    esac
done

# --- 0. Dispatch mailbox check (--dispatch) ----------------------------------
# Runs before the gauntlet and before worktree validation, so a coordinator can
# interrogate a dispatch's mailbox without a worktree. `inbox` is used rather
# than `check` — measured on one run, `check` surfaced 1 message of 20.
check_dispatch_mailbox() {
    local ctx="$1"
    local inbox_json
    if ! inbox_json="$(orca orchestration inbox --json --limit 1000 2>/dev/null)"; then
        echo "mill-verify: warning: cannot read the orchestration mailbox (orca orchestration inbox failed)" >&2
        return 0
    fi

    # Resolve the dispatch to its terminal handle. A `send --type question`
    # message carries no ctx id (payload=null, from_handle is the terminal), so
    # the terminal handle is the only link back to the dispatch. worker-list
    # maps ctx -> task; dispatch-show maps task -> the assignee terminal.
    local terminal="" task_id
    task_id="$(orca orchestration worker-list --json 2>/dev/null | jq -r --arg c "$ctx" '
        [ .result.workers[] | select(.dispatchId == $c) | .taskId ] | .[0] // empty
    ' 2>/dev/null)"
    if [[ -n "$task_id" ]]; then
        terminal="$(orca orchestration dispatch-show --task "$task_id" --json 2>/dev/null | jq -r '.result.dispatch.assignee_handle // empty' 2>/dev/null)"
    fi

    # A message belongs to this dispatch when the ctx id appears in its payload
    # (worker_done passes --dispatch-id) or its from/to handle (ask questions),
    # or when it was sent from the dispatch's own terminal (send questions).
    echo "mill-verify: mailbox for dispatch $ctx:"
    echo "$inbox_json" | jq -r --arg c "$ctx" --arg t "$terminal" '
        .result.messages[]
        | select(
            ((.payload // "") | tostring | contains($c))
            or ((.from_handle // "") | tostring | contains($c))
            or ((.to_handle // "") | tostring | contains($c))
            or (($t != "") and ((.from_handle // "") == $t))
          )
        | "  [\(.type // "?")] \(.id) \(.subject // "") (\(.created_at // "?"))"
    ' 2>/dev/null || true

    # A missing worker_done is NOT a failure: #177 showed Orca settling a task
    # as failed while the worker was still running, rejecting the worker_done.
    local worker_done
    worker_done="$(echo "$inbox_json" | jq -r --arg c "$ctx" '
        [ .result.messages[]
          | select(.type == "worker_done" and ((.payload // "") | tostring | contains($c))) ]
        | length
    ' 2>/dev/null || echo 0)"
    if [[ "$worker_done" == "0" ]]; then
        echo "mill-verify: warning: no worker_done for dispatch $ctx (not a failure)" >&2
    fi

    # An unresolvable dispatch is not evidence of an unanswered question: its
    # send questions cannot be attributed to it, so warn and do not fail.
    if [[ -z "$terminal" ]]; then
        echo "mill-verify: warning: cannot resolve dispatch $ctx to a terminal handle; its questions are unattributable (not a failure)" >&2
        return 0
    fi

    # An unanswered question is a hard failure. A question is "answered" when
    # a distinct message carries thread_id equal to the question's id: the
    # coordinator's reply comes back as a status message whose thread_id is the
    # question id. The `read` flag is not the signal — measured 2026-08-31,
    # `reply` does not set read, so a question stayed read==0 after being
    # answered. An `ask` question self-threads (thread_id == its own id), so
    # the question itself is excluded: only a reply that joins the thread
    # counts as an answer.
    local unanswered
    unanswered="$(echo "$inbox_json" | jq -r --arg c "$ctx" --arg t "$terminal" '
        .result.messages as $msgs
        | [ $msgs[]
            | select(.type == "question"
                and ( ((.payload // "") | tostring | contains($c))
                      or ((.from_handle // "") | tostring | contains($c))
                      or ((.to_handle // "") | tostring | contains($c))
                      or ((.from_handle // "") == $t) ))
          ]
        | .[] as $q
        | select( ([ $msgs[] | select(.thread_id == $q.id and .id != $q.id) ] | length) == 0 )
        | "\($q.id) \($q.subject // "")"
    ' 2>/dev/null || true)"
    if [[ -n "$unanswered" ]]; then
        echo "mill-verify: FAIL — unanswered question for dispatch $ctx:" >&2
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            echo "  $line" >&2
        done <<< "$unanswered"
        return 1
    fi

    return 0
}

if [[ -n "$dispatch" ]]; then
    check_dispatch_mailbox "$dispatch"
    mailbox_rc=$?
    if [[ "$mailbox_rc" -ne 0 ]]; then
        exit 1
    fi
    # --dispatch alone: the mailbox was the whole request.
    if [[ -z "$worktree" && -z "$role" ]]; then
        exit 0
    fi
fi

if [[ -z "$worktree" || -z "$role" ]]; then
    echo "usage: mill-verify --worktree <path> --role <role> --project-root <path> [--files-modified <a,b,c>]" >&2
    exit 2
fi
if [[ -z "$project_root" ]]; then
    echo "error: --project-root is required (it supplies .mill/role-capabilities and .mill/gauntlet; it is never inferred from the working directory)" >&2
    echo "usage: mill-verify --worktree <path> --role <role> --project-root <path> [--files-modified <a,b,c>]" >&2
    exit 2
fi

if [[ ! -d "$worktree" ]]; then
    echo "error: no such worktree: $worktree" >&2
    exit 1
fi
if [[ ! -d "$project_root" ]]; then
    echo "error: no such project root: $project_root" >&2
    exit 1
fi

# Resolve the checks' own directory before moving into the worktree: the
# role definitions read from the install root (where these checks live);
# the worktree's copy must never be picked up instead. Resolving after
# `cd "$worktree"` would do exactly that.
here="$(cd "$(dirname "$0")" && pwd)"
role_enforce="$here/role-enforce"
if [[ ! -x "$role_enforce" ]]; then
    echo "error: role-enforce not found next to mill-verify" >&2
    exit 1
fi

# ADR 0014 (#194): the project root is resolved HERE, before cd'ing into the
# worktree — never after, and never inferred from the working directory, which
# inside this script is the tree under judgement. Resolve both to real paths
# (pwd -P follows symlinks) so a symlink or a trailing slash cannot defeat the
# comparison, then refuse when they are the same tree: judging a worktree with
# the .mill/role-capabilities that governs it lets a worker supply the file
# that decides its own permissions (#195).
project_root="$(cd "$project_root" && pwd -P)"
worktree="$(cd "$worktree" && pwd -P)"
if [[ "$project_root" == "$worktree" ]]; then
    echo "error: the project root and the worktree are the same tree; refusing" >&2
    echo "  project root: $project_root" >&2
    echo "  worktree:     $worktree" >&2
    exit 1
fi

cd "$worktree" || exit 1

violation=0

# --- 1. The gauntlet: build, lint, test in the worktree ----------------------
# load_gauntlet and run_step live in common.sh beside this script. The config
# is read from the project root (.mill/gauntlet, passed via --project-root), but
# run_step evaluates the commands in the current cwd — the worktree — so the
# gauntlet checks exactly what the worker produced. With no .mill/gauntlet
# configured, load_gauntlet says so and skips the steps — a project with no
# gauntlet config fails nothing, like the hooks did. Role enforcement below
# is independent and always runs.
# shellcheck source=common.sh
source "$here/common.sh"

load_gauntlet "$project_root"
run_step build
run_step lint
run_step test

# --- 2. Role capability enforcement over the change set ----------------------
# --files-modified is authoritative: it is the exact change set the worker
# reported. Without it, fall back to the git diff since the worktree's base
# commit (its oldest reflog entry — where the worker started).
#
# Entries may carry a git status prefix — a single letter (A, M, D, R) followed
# by whitespace, then the path. Without a prefix — backwards-compatible bare
# paths — the entry is judged as a write exactly as before. Deletions (D) are
# not writes: the role never produced that file, so they are skipped. Renames
# (R) judge the new path and skip the old as a deletion. Anything unrecognised
# is judged as a write — fail closed.
judge_write() {
    if ! "$role_enforce" --test "$role" --project-root "$project_root" --base-dir "$worktree" "$1" >/dev/null 2>&1; then
        echo "error: $1 is not allowed for role '$role'" >&2
        violation=1
        printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" verify "$role" "$1" >> "$here/../rejections.log" 2>/dev/null || true
    fi
    return 0
}

skip_deleted() {
    echo "mill-verify: skipping deleted path $1 (not a write)" >&2
    return 0
}

if [[ -n "$files_modified" ]]; then
    # Trim spaces around commas: payloads may arrive as "a, b, c".
    entries="$(printf '%s' "$files_modified" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        if [[ "$entry" =~ ^([AMDR])[[:space:]]+(.+) ]]; then
            status="${BASH_REMATCH[1]}"
            rest="${BASH_REMATCH[2]}"
            case "$status" in
                A|M)
                    judge_write "$rest"
                    ;;
                D)
                    skip_deleted "$rest"
                    ;;
                R)
                    old="${rest%%[[:space:]]*}"
                    new="$(printf '%s' "${rest#*[[:space:]]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
                    if [[ -n "$old" ]]; then
                        skip_deleted "$old"
                    fi
                    if [[ -n "$new" ]]; then
                        judge_write "$new"
                    fi
                    ;;
            esac
        else
            judge_write "$entry"
        fi
    done <<< "$entries"
else
    base="$(git reflog --format=%H | tail -1)"
    if [[ -z "$base" || "$(git cat-file -t "$base" 2>/dev/null)" != "commit" ]]; then
        echo "error: cannot determine worktree base commit (pass --files-modified)" >&2
        exit 1
    fi
    while IFS=$'\t' read -r code path1 path2; do
        [[ -z "$code" ]] && continue
        # Strip the trailing similarity score from the status code (R100 → R, C75 → C).
        letter="${code%%[0-9]*}"
        case "$letter" in
            D)
                skip_deleted "$path1"
                ;;
            R)
                skip_deleted "$path1"
                judge_write "$path2"
                ;;
            *)
                # Additions, modifications, typechanges, copies, and anything
                # else: judge as a write. Fail closed.
                judge_write "$path1"
                if [[ -n "$path2" ]]; then
                    judge_write "$path2"
                fi
                ;;
        esac
    done < <(git diff --name-status "$base" HEAD)
fi

# --- 3. Nothing left uncommitted ---------------------------------------------
uncommitted="$(git status --porcelain)"
if [[ -n "$uncommitted" ]]; then
    echo "error: uncommitted work left in the worktree:" >&2
    echo "$uncommitted" | sed 's/^/  /' >&2
    violation=1
fi

if [[ "$violation" -eq 0 ]]; then
    echo "mill-verify: PASS — role '$role' satisfied, gauntlet clean"
fi
exit "$violation"
