#!/usr/bin/env bash
# role-enforce — pre-commit capability enforcement.
# Usage:
#   checks/role-enforce              — git pre-commit hook
#   checks/role-enforce --test <role> <file>  — test mode
#   checks/role-enforce --test <role> --base-dir <path> <file>  — test mode,
#       read the file's content from <path> instead of the current directory.
#       while the role definition and the role-capabilities config are still
#       resolved from the script's own location (the coordinator's Mill root).
#       The trust rule is unchanged; this only widens where the file content is
#       read from.
#
# Exits 0 if allowed, 1 if blocked, 2 on usage error.

set -euo pipefail

# mill_root is the coordinator's Mill root — the repository these checks live
# in, derived from this script's own location, never from the current working
# directory. Every file that decides what a role may write resolves from here:
# the role definitions (.mill/roles/*/ROLE.md) and the capability map
# (.mill/role-capabilities). No such file may be read from the working
# directory or the worktree being judged — configuration that governs a worker
# cannot live in that worker's output, or the worker could widen its own
# permissions by editing the file. Only the content of the files under
# judgement comes from the worktree (BASE_DIR below); the rules that judge it
# never do.
mill_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ROLES_DIR=".mill/roles"
CAPABILITIES_FILE=".mill/role-capabilities"

# BASE_DIR is the directory the file-content read is resolved against in
# --test mode. Defaults to the current directory (pre-commit hook behaviour).
# mill-verify passes --base-dir <worktree> so a worker's new file is read
# from the worktree, not from the coordinator's repository where it does not
# exist. The role definition and the capability map always resolve from
# mill_root above and are unaffected by this variable.
BASE_DIR=""

# --- helpers ----------------------------------------------------------------

# parse_list extracts a YAML list field from ROLE.md frontmatter.
# Args: field_name file_path → space-separated values (or empty string).
parse_list() {
    local field="$1" file="$2"
    awk -v field="$field" '
      $0 ~ "^" field ":" {
        gsub("^" field ": *", "")
        gsub(/[\[\]]/, "")
        gsub(/,/, " ")
        if ($0 != "") { print $0 }
        else { flag=1; next }
      }
      flag && !/^  - /    { exit }
      flag && /^  - /     { gsub(/^  - /, ""); print }
    ' "$file" | xargs 2>/dev/null
}

# resolve_categories maps a role's allowed_files categories to the project's
# file patterns via .mill/role-capabilities (same shape as .mill/gauntlet:
# plain bash, sourced). An unmapped category or a missing capabilities file
# fails closed — it blocks, never allows.
resolve_categories() {
    local role="$1" role_md="$2"

    # Parse the role's declared categories (e.g. code, docs, config).
    local categories
    categories=$(parse_list "allowed_files" "$role_md")
    if [[ -z "$categories" ]]; then
        echo "pre-commit: BLOCKED — role '$role' has no file permissions." >&2
        echo "  $role has an empty allowed_files list." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi

    # Load the category → pattern map from mill_root (the coordinator's Mill
    # root), never from the worktree being verified — see the invariant at the
    # top of this script.
    local cfg="$mill_root/$CAPABILITIES_FILE"
    if [[ ! -f "$cfg" ]]; then
        echo "pre-commit: BLOCKED — role '$role' cannot commit: no $CAPABILITIES_FILE." >&2
        echo "  Role '$role' may write: $categories" >&2
        echo "  Map those categories to file patterns in .mill/role-capabilities" >&2
        echo "  (copy the example from .mill/role-capabilities.example)." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$cfg"

    # Expand categories into patterns; unmapped categories block.
    local expanded="" missing=""
    local c
    for c in $categories; do
        local patterns
        patterns="${!c:-}"
        if [[ -z "$patterns" ]]; then
            missing="$missing $c"
            continue
        fi
        expanded="$expanded $patterns"
    done
    if [[ -n "$missing" ]]; then
        echo "pre-commit: BLOCKED — role '$role' declares categories not in $CAPABILITIES_FILE:$missing" >&2
        echo "  Add the missing category or edit the role's allowed_files." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi

    echo "$expanded" | xargs
}

# check_forbidden returns 0 if the file basename is NOT forbidden.
# Args: filename forbidden_patterns
check_forbidden() {
    local file="$1" forbidden="$2"
    local basename
    basename=$(basename "$file")

    if [[ -z "$forbidden" ]]; then
        return 0
    fi

    for p in $forbidden; do
        if [[ "$basename" == "$p" ]]; then
            return 1
        fi
    done

    return 0
}

# enforce_file checks a single file against role capabilities.
# Args: role role_md_path file_path → exits on first violation.
enforce_file() {
    local role="$1" role_md="$2" file="$3"

    # Parse frontmatter fields
    local allowed forbidden
    allowed=$(parse_list "allowed_files" "$role_md")
    forbidden=$(parse_list "forbidden_patterns" "$role_md")

    # 1. Check forbidden patterns first (takes precedence)
    if ! check_forbidden "$file" "$forbidden"; then
        local basename
        basename=$(basename "$file")
        echo "pre-commit: BLOCKED — role '$role' cannot modify $basename (forbidden)." >&2
        exit 1
    fi

    # 2. Resolve the role's categories to the project's file patterns
    allowed=$(resolve_categories "$role" "$role_md")

    # 3. Resolve the file's extension, then check it against the patterns.
    #    ${file##*.} strips at the last dot in the whole PATH, so a file with no
    #    extension ("checks/role-enforce") yielded the entire path as its
    #    "extension" and could never match any pattern: no role could modify an
    #    extensionless file, including Mill's own gates and checks. Take the
    #    basename first, and classify an extensionless file by its shebang — a
    #    shell script is a shell script whether or not it is named ".sh".
    #    Anything extensionless that is not a shell script still matches no
    #    pattern, so it stays blocked: this widens nothing but shell scripts.
    #
    #    The shebang read uses BASE_DIR (set by --base-dir in --test mode, or
    #    empty in pre-commit mode). In pre-commit mode cwd is the worker's
    #    repo, so the file is there; in --test mode invoked from the
    #    coordinator, BASE_DIR is the worktree so the file is read from there.
    #    The role definition and the capability map are always read from
    #    mill_root (see the invariant at the top of this script) and are never
    #    affected by BASE_DIR — only the file content read above is.
    local base ext ext_lc shebang content_path
    base=$(basename "$file")
    if [[ -n "$BASE_DIR" ]]; then
        content_path="$BASE_DIR/$file"
    else
        content_path="$file"
    fi
    if [[ "$base" == *.* ]]; then
        ext=".${base##*.}"
    else
        shebang=""
        if [[ -r "$content_path" ]]; then
            IFS= read -r shebang < "$content_path" 2>/dev/null || true
        fi
        if [[ "$shebang" =~ ^#!.*(bash|sh)([[:space:]]|$) ]]; then
            ext=".sh"
        else
            ext=""
        fi
    fi
    ext_lc=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    for a in $allowed; do
        if [[ "$a" == "$ext_lc" ]]; then
            return 0
        fi
        # A list entry may also be an exact basename. Match only the full
        # basename — never a path, never a prefix, never a glob — so that an
        # entry like `role-capabilities` cannot match `my-role-capabilities`
        # or `role-capabilities.example`. A leading dot stays part of the
        # entry, so `.gitignore` matches `.gitignore` and nothing else.
        if [[ "$a" == "$base" ]]; then
            return 0
        fi
    done

    # Not allowed
    local allowed_list
    allowed_list=$(echo "$allowed" | tr ' ' ', ')
    echo "pre-commit: BLOCKED — role '$role' cannot commit $ext_lc files." >&2
    echo "  $role can produce: $allowed_list" >&2
    echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
    exit 1
}

# --- test mode --------------------------------------------------------------
# Parse --test <role> [--base-dir <path>] <file>. --base-dir is optional and
# only affects where the file content is read from; the role definition and the
# capability map still resolve from mill_root (this script's own location) so
# the trust rule holds.
if [[ "${1:-}" == "--test" ]]; then
    shift
    ROLE=""
    FILE=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --base-dir)
                BASE_DIR="${2:-}"
                shift 2
                ;;
            --base-dir=*)
                BASE_DIR="${1#--base-dir=}"
                shift
                ;;
            -*)
                echo "role-enforce: unknown option: $1" >&2
                exit 2
                ;;
            *)
                if [[ -z "$ROLE" ]]; then
                    ROLE="$1"
                else
                    FILE="$1"
                fi
                shift
                ;;
        esac
    done
    if [[ -z "$ROLE" || -z "$FILE" ]]; then
        echo "Usage: $0 --test <role> [--base-dir <path>] <file>" >&2
        exit 2
    fi

    ROLE_MD="$mill_root/$ROLES_DIR/$ROLE/ROLE.md"
    if [[ ! -f "$ROLE_MD" ]]; then
        echo "role-enforce: unknown role '$ROLE' (no $ROLE_MD)" >&2
        exit 2
    fi

    enforce_file "$ROLE" "$ROLE_MD" "$FILE"
    exit 0
fi

# --- pre-commit mode --------------------------------------------------------
# Check for --no-verify
for arg in "$@"; do
    if [[ "$arg" == "--no-verify" ]]; then
        exit 0
    fi
done

# Read active role
MILL_DIR=".mill"
ROLE_STATE="$MILL_DIR/role"
if [[ ! -f "$ROLE_STATE" ]]; then
    exit 0
fi

ROLE=$(tr -d '[:space:]' < "$ROLE_STATE")
if [[ -z "$ROLE" ]]; then
    exit 0
fi

ROLE_MD="$mill_root/$ROLES_DIR/$ROLE/ROLE.md"
if [[ ! -f "$ROLE_MD" ]]; then
    echo "pre-commit: BLOCKED — role '$ROLE' names a role with no ROLE.md at $ROLE_MD" >&2
    exit 1
fi

# Get staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [[ -z "$STAGED" ]]; then
    exit 0
fi

# Check each staged file
BLOCKED_FILES=""
while IFS= read -r f; do
    [[ -z "$f" ]] && continue

    # Run enforcement as subshell to capture violation without exiting main loop
    if ! enforce_file "$ROLE" "$ROLE_MD" "$f"; then
        # enforce_file already printed the error; capture via subshell result
        if [[ -z "$BLOCKED_FILES" ]]; then
            BLOCKED_FILES="$f"
        else
            BLOCKED_FILES="$BLOCKED_FILES $f"
        fi
    fi
done <<< "$STAGED"

if [[ -n "$BLOCKED_FILES" ]]; then
    # Log enforcement
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$MILL_DIR"
    echo "[$TIMESTAMP] BLOCKED $ROLE $BLOCKED_FILES" >> "$MILL_DIR/enforcement.log"

    # Re-run enforcement on first file to get the error message (it exits 1)
    FIRST=$(echo "$BLOCKED_FILES" | cut -d' ' -f1)
    enforce_file "$ROLE" "$ROLE_MD" "$FIRST"
    exit 1
fi

exit 0
