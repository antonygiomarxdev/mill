#!/bin/bash
# Mill role-based capability enforcement.
# Reads .mill/role to determine active role and blocks disallowed actions.
# Bootstrap enforcement until runner handles this natively.
set -euo pipefail

ROLE_FILE=".mill/role"
ROLE=$(cat "$ROLE_FILE" 2>/dev/null || echo "none")

STAGED=$(git diff --cached --name-only 2>/dev/null || true)
GO_FILES=$(echo "$STAGED" | grep -E '\.go$' || true)
MD_FILES=$(echo "$STAGED" | grep -E '\.md$' || true)
IMPL=$(echo "$STAGED" | grep -E '^(cmd/|internal/).*\.go$' || true)

case "$ROLE" in
  staff)
    # Staff: can write docs, roles, config. Cannot write implementation.
    if [ -n "$IMPL" ]; then
      echo "BLOCKED: Staff does not write implementation code."
      echo "Affected: $IMPL"
      echo "Delegate: mill delegate <issue> --role sr-dev"
      exit 1
    fi
    ;;
  pm)
    # PM: can write specs, docs. Cannot write code or config.
    if [ -n "$GO_FILES" ]; then
      echo "BLOCKED: PM does not write code."
      echo "Delegate to Tech Lead for technical specs."
      exit 1
    fi
    ;;
  tech-lead)
    # Tech Lead: can review specs. Cannot write implementation without Architect approval.
    if [ -n "$IMPL" ]; then
      echo "WARNING: Tech Lead writing implementation. Architect approval required."
      echo "Continue? Set ARCHITECT_APPROVED=1 to bypass."
      if [ "${ARCHITECT_APPROVED:-}" != "1" ]; then
        exit 1
      fi
    fi
    ;;
  sr-dev*)
    # Sr. Dev: can write code. Cannot modify roles or config.
    ROLE_CONFIG=$(echo "$STAGED" | grep -E '^(roles/|mill\.yml|\.mill/config)' || true)
    if [ -n "$ROLE_CONFIG" ]; then
      echo "BLOCKED: Sr. Dev does not modify roles or config."
      echo "Affected: $ROLE_CONFIG"
      exit 1
    fi
    ;;
  none)
    echo "WARNING: No role set. Run: echo 'staff' > .mill/role"
    echo "Set role and retry."
    exit 1
    ;;
  *)
    echo "Unknown role: $ROLE"
    exit 1
    ;;
esac

exit 0
