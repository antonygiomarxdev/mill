#!/usr/bin/env bash
# role-enforce — role capability enforcement (--test only).
# Usage:
#   checks/role-enforce --test <role> --project-root <path> <file>  — test mode
#   checks/role-enforce --test <role> --project-root <path> --base-dir <path> <file>
#       — test mode, read the file's content from <path> instead of the current
#       directory. The role definition still resolves from the script's own
#       location (the install root), and the role-capabilities config resolves
#       from --project-root (the project root the caller supplies). The trust
#       rule is unchanged; this only widens where the file content is read from.
#
# --test is the only mode. Any other invocation — bare, or a git hook script
# invoking this as its capability check — prints this usage and exits 2: a
# gate's default must never be a silent pass.
#
# Exits 0 if allowed, 1 if blocked, 2 on usage error.

set -euo pipefail

# mill_root is the install root — the repository these checks live in, derived
# from this script's own location, never from the current working directory.
# The role definitions (.mill/roles/*/ROLE.md) resolve from here.
#
# #195 — the trust rule: no file that decides what a role may write may be
# read from the working directory or the worktree being judged. Configuration
# that governs a worker cannot live in that worker's output, or the worker
# could widen its own permissions by editing the file. Only the content of the
# files under judgement comes from the worktree (BASE_DIR below); the rules
# that judge it never do.
#
# #194 / ADR 0014 — two roots: the capability map (.mill/role-capabilities)
# does NOT resolve from mill_root. It resolves from the project root the
# caller supplies via --project-root, because the map differs per project and
# cannot be packaged. The project root is resolved by the caller before it
# enters the worktree, and passed explicitly. It is never inferred from the
# working directory by the script that reads the file, because inside
# mill-verify that directory is the tree under judgement. The project root and
# the judged worktree must be distinct trees, and the tooling refuses to run
# when they are not. --project-root is required: an absent flag is a loud
# usage error, never a silent fallback to the working directory.
mill_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ROLES_DIR=".mill/roles"
CAPABILITIES_FILE=".mill/role-capabilities"
PROJECT_ROOT=""

# BASE_DIR is the directory the file-content read is resolved against in
# --test mode. Defaults to the current directory.
# mill-verify passes --base-dir <worktree> so a worker's new file is read
# from the worktree, not from the coordinator's repository where it does not
# exist. The role definition resolves from mill_root above and the capability
# map from PROJECT_ROOT; neither is affected by this variable.
BASE_DIR=""

# --- helpers ----------------------------------------------------------------

# parse_list extracts a YAML list field from ROLE.md frontmatter.
# Args: field_name file_path → space-separated values (or empty string).
parse_list() {
    local field="$1" file="$2"
    awk -v field="$field" '
      $0 ~ "^" field ":" {
        gsub("^" field ": *", "")
        gsub(/[\[\]]/, "")
        gsub(/,/, " ")
        if ($0 != "") { print $0 }
        else { flag=1; next }
      }
      flag && !/^  - /    { exit }
      flag && /^  - /     { gsub(/^  - /, ""); print }
    ' "$file" | xargs 2>/dev/null
}

# resolve_categories maps a role's allowed_files categories to the project's
# file patterns via .mill/role-capabilities (same shape as .mill/gauntlet:
# plain bash, sourced). An unmapped category or a missing capabilities file
# fails closed — it blocks, never allows.
resolve_categories() {
    local role="$1" role_md="$2"

    # Parse the role's declared categories (e.g. code, docs, config).
    local categories
    categories=$(parse_list "allowed_files" "$role_md")
    if [[ -z "$categories" ]]; then
        echo "role-enforce: BLOCKED — role '$role' has no file permissions." >&2
        echo "  $role has an empty allowed_files list." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi

    # Load the category → pattern map from PROJECT_ROOT (the project root the
    # caller passed via --project-root), never from the worktree being
    # verified — see the invariant at the top of this script.
    local cfg="$PROJECT_ROOT/$CAPABILITIES_FILE"
    if [[ ! -f "$cfg" ]]; then
        echo "role-enforce: BLOCKED — role '$role' cannot commit: no $CAPABILITIES_FILE." >&2
        echo "  Role '$role' may write: $categories" >&2
        echo "  Map those categories to file patterns in .mill/role-capabilities" >&2
        echo "  (copy the example from .mill/role-capabilities.example)." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$cfg"

    # Expand categories into patterns; unmapped categories block.
    local expanded="" missing=""
    local c
    for c in $categories; do
        local patterns
        patterns="${!c:-}"
        if [[ -z "$patterns" ]]; then
            missing="$missing $c"
            continue
        fi
        expanded="$expanded $patterns"
    done
    if [[ -n "$missing" ]]; then
        echo "role-enforce: BLOCKED — role '$role' declares categories not in $CAPABILITIES_FILE:$missing" >&2
        echo "  Add the missing category or edit the role's allowed_files." >&2
        echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
        exit 1
    fi

    echo "$expanded" | xargs
}

# check_forbidden returns 0 if the file basename is NOT forbidden.
# Args: filename forbidden_patterns
check_forbidden() {
    local file="$1" forbidden="$2"
    local basename
    basename=$(basename "$file")

    if [[ -z "$forbidden" ]]; then
        return 0
    fi

    for p in $forbidden; do
        if [[ "$basename" == "$p" ]]; then
            return 1
        fi
    done

    return 0
}

# enforce_file checks a single file against role capabilities.
# Args: role role_md_path file_path → exits on first violation.
enforce_file() {
    local role="$1" role_md="$2" file="$3"

    # Parse frontmatter fields
    local allowed forbidden
    allowed=$(parse_list "allowed_files" "$role_md")
    forbidden=$(parse_list "forbidden_patterns" "$role_md")

    # 1. Check forbidden patterns first (takes precedence)
    if ! check_forbidden "$file" "$forbidden"; then
        local basename
        basename=$(basename "$file")
        echo "role-enforce: BLOCKED — role '$role' cannot modify $basename (forbidden)." >&2
        exit 1
    fi

    # 2. Resolve the role's categories to the project's file patterns
    allowed=$(resolve_categories "$role" "$role_md")

    # 3. Resolve the file's extension, then check it against the patterns.
    #    ${file##*.} strips at the last dot in the whole PATH, so a file with no
    #    extension ("checks/role-enforce") yielded the entire path as its
    #    "extension" and could never match any pattern: no role could modify an
    #    extensionless file, including Mill's own gates and checks. Take the
    #    basename first, and classify an extensionless file by its shebang — a
    #    shell script is a shell script whether or not it is named ".sh".
    #    Anything extensionless that is not a shell script still matches no
    #    pattern, so it stays blocked: this widens nothing but shell scripts.
    #
    #    The shebang read uses BASE_DIR (set by --base-dir). With no --base-dir
    #    the file is read relative to the current directory; mill-verify passes
    #    --base-dir <worktree>, so the file is read from the worktree.
    #    The role definition reads from mill_root and the capability map from
    #    PROJECT_ROOT (see the invariants at the top of this script); neither
    #    is affected by BASE_DIR — only the file content read above is.
    local base ext ext_lc shebang content_path
    base=$(basename "$file")
    if [[ -n "$BASE_DIR" ]]; then
        content_path="$BASE_DIR/$file"
    else
        content_path="$file"
    fi
    if [[ "$base" == *.* ]]; then
        ext=".${base##*.}"
    else
        shebang=""
        if [[ -r "$content_path" ]]; then
            IFS= read -r shebang < "$content_path" 2>/dev/null || true
        fi
        if [[ "$shebang" =~ ^#!.*(bash|sh)([[:space:]]|$) ]]; then
            ext=".sh"
        else
            ext=""
        fi
    fi
    ext_lc=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    # A list entry may name a file in one of three forms; the entry's own
    # characters decide which, checked in this order:
    #
    #   1. Contains `/` — a glob matched against the file's repo-relative
    #      path, exactly as it was passed in: `test/*.sh` allows
    #      `test/role-tests-category.sh` and nothing outside test/. The
    #      `[[ x == pattern ]]` globs let `*` cross `/`, so `*/__tests__/*`
    #      reaches a __tests__ directory at any depth and `**` buys nothing.
    #
    #   2. Contains `*` but no `/` — a glob matched against the basename:
    #      `*.test.*` allows `collections.test.ts` without letting the glob
    #      reach the directories around it.
    #
    #   3. Contains neither — today's behaviour exactly: an extension if it
    #      starts with `.`, an exact basename otherwise. Literal stays
    #      literal — never a path, never a prefix, never a glob — so an
    #      entry like `role-capabilities` cannot match `my-role-capabilities`
    #      or `role-capabilities.example`. A leading dot stays part of the
    #      entry, so `.gitignore` matches `.gitignore` and nothing else.
    # Read the pattern list into an array without pathname expansion. A bare
    # `for a in $allowed` would word-split AND let bash glob each pattern
    # against the current working directory before the loop saw it, so
    # `test/*.sh` became whatever test files happened to exist where the gate
    # was invoked — a verdict that depends on the caller's cwd (the same
    # class as the #195 rule above). `read -a` splits on IFS and globs
    # nothing; each element below is still pattern-matched because `$a` stays
    # unquoted on the right of `==`.
    local -a allowed_arr
    read -r -a allowed_arr <<< "$allowed"
    for a in "${allowed_arr[@]}"; do
        if [[ "$a" == */* ]]; then
            # Form 1: repo-relative path glob.
            if [[ "$file" == $a ]]; then
                return 0
            fi
        elif [[ "$a" == *"*"* ]]; then
            # Form 2: basename glob.
            if [[ "$base" == $a ]]; then
                return 0
            fi
        else
            # Form 3: literal extension (case-insensitive) or exact basename.
            if [[ "$a" == "$ext_lc" ]]; then
                return 0
            fi
            if [[ "$a" == "$base" ]]; then
                return 0
            fi
        fi
    done

    # Not allowed
    local allowed_list
    allowed_list=$(echo "$allowed" | tr ' ' ', ')
    echo "role-enforce: BLOCKED — role '$role' cannot commit $ext_lc files." >&2
    echo "  $role can produce: $allowed_list" >&2
    echo "  To proceed: the role comes from the dispatch; the coordinator verifies with 'mill-verify --role <role>'." >&2
    exit 1
}

# --- test mode --------------------------------------------------------------
# Parse --test <role> --project-root <path> [--base-dir <path>] <file>.
# --project-root is required: it names the project root whose
# .mill/role-capabilities judges the file, and it must come from the caller —
# never from the working directory (see the ADR 0014 invariant above).
# --base-dir is optional and only affects where the file content is read from.
if [[ "${1:-}" == "--test" ]]; then
    shift
    ROLE=""
    FILE=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-root)
                PROJECT_ROOT="${2:-}"
                shift 2
                ;;
            --project-root=*)
                PROJECT_ROOT="${1#--project-root=}"
                shift
                ;;
            --base-dir)
                BASE_DIR="${2:-}"
                shift 2
                ;;
            --base-dir=*)
                BASE_DIR="${1#--base-dir=}"
                shift
                ;;
            -*)
                echo "role-enforce: unknown option: $1" >&2
                exit 2
                ;;
            *)
                if [[ -z "$ROLE" ]]; then
                    ROLE="$1"
                else
                    FILE="$1"
                fi
                shift
                ;;
        esac
    done
    if [[ -z "$ROLE" || -z "$FILE" ]]; then
        echo "Usage: $0 --test <role> --project-root <path> [--base-dir <path>] <file>" >&2
        exit 2
    fi
    # Safe default: there is none. An absent --project-root never falls back to
    # the working directory — inside mill-verify that directory is the tree
    # under judgement, and a capability map read from there is a worker
    # supplying the file that governs its own permissions (#195). Refuse.
    if [[ -z "$PROJECT_ROOT" ]]; then
        echo "role-enforce: missing --project-root (the project root supplies .mill/role-capabilities; it is never inferred from the working directory)" >&2
        echo "Usage: $0 --test <role> --project-root <path> [--base-dir <path>] <file>" >&2
        exit 2
    fi

    ROLE_MD="$mill_root/$ROLES_DIR/$ROLE/ROLE.md"
    if [[ ! -f "$ROLE_MD" ]]; then
        echo "role-enforce: unknown role '$ROLE' (no $ROLE_MD)" >&2
        exit 2
    fi

    enforce_file "$ROLE" "$ROLE_MD" "$FILE"
    exit 0
fi

# --- no other mode ----------------------------------------------------------
# --test is the only mode. Any other invocation — bare, or with arguments that
# are not --test — is a usage error, never a silent pass. Mill ships no git
# hook script, so nothing may run this as one; a hook calling it with no
# arguments gets a loud failure, not an acceptance.
echo "Usage: $0 --test <role> --project-root <path> [--base-dir <path>] <file>" >&2
exit 2
