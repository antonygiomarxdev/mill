#!/bin/bash
# Mill gauntlet configuration — copy to .mill/gauntlet and edit.
#
# Each gauntlet step is a shell command run by .mill/checks/mill-verify, the
# verification entry point the coordinator invokes against a worker's worktree
# after every dispatch. The gauntlet structure — build, lint, test — each a
# named check that blocks — is language-agnostic; only the commands are
# ecosystem-specific, and they are declared here.
#
# Leave a step unset to skip it. A project with no .mill/gauntlet file at all
# gets no build/lint/test checks (mill-verify says so and skips them); role
# enforcement still runs.
#
# Environment variables in commands are expanded at run time, so
# `test="go test $PKG"` works. The step must exit 0 on success.

# verification steps:
build="npm run build"
lint="npm run lint"
test="npm test"
