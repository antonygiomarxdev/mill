# role-capabilities — maps a role's declared capabilities to file patterns.
#
# Roles declare categories (code, docs, config, policy, scripts, design) in the
# allowed_files field of their ROLE.md. This file says what those mean HERE.
# Mill ships no default: a project's languages are its own, and guessing them
# is how the roles ended up hardcoded to .go.
#
# Uncomment and edit for your stack. Examples, not defaults:
#
#   code=".ts .tsx .js .jsx .css"        # a TypeScript project
#   code=".py .pyi"                      # Python
#   code=".rs"                           # Rust
#   code=".go"                           # Go
#   code=".kt .java"                     # JVM
#
# Without this file role-enforce blocks everything and says so. That is
# deliberate: a capability gate that fails open is not a gate.

code=""
docs=".md"
# A list entry may be an extension or an exact filename. Extensions are
# matched case-insensitively against the file's last component; an exact
# filename is matched only against the file's basename, so `role-capabilities`
# matches `role-capabilities` and nothing else (not `my-role-capabilities`,
# not `role-capabilities.example`). `.gitignore` keeps its leading dot so the
# matcher can tell a hidden-file basename from an extension.
config=".yml .yaml .json .toml .gitignore"
policy=".md .sh .example role-capabilities"
scripts=".sh"
design=".pen .fig"
