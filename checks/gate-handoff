#!/usr/bin/env bash
# gate-handoff — verify a non-leaf role dispatched its successor before completing
# Usage: gate-handoff <issue-number>
# Checks the ledger for a completed non-leaf delegation and verifies a child
# dispatch event exists. Exits 0 if: no ledger yet, leaf role completed, or
# a child dispatch exists for a non-leaf role. Exits 1 if a non-leaf role
# completed with verdict "approved" but no child dispatch was recorded.
set -euo pipefail

ISSUE="${1:-}"

if [[ -z "$ISSUE" ]]; then
    echo "Usage: gate-handoff <issue-number>" >&2
    exit 2
fi

LEDGER=".mill/ledger/${ISSUE}.jsonl"

# --- Non-leaf role detection: read delegates_to from ROLE.md frontmatter ---
# Returns 0 if the role has at least one delegate, 1 if leaf (empty delegates_to).
is_non_leaf() {
    local role="$1"
    local role_file=".mill/roles/${role}/ROLE.md"
    if [[ ! -f "$role_file" ]]; then
        return 1  # unknown role → treat as leaf
    fi
    # Extract delegates_to entries (same awk strategy as gate-route)
    local delegates
    delegates=$(awk '
        /^delegates_to:/   { flag=1; next }
        flag && !/^  - /   { exit }
        flag && /^  - /    { sub(/^  - /, ""); print }
    ' "$role_file")
    [[ -n "$delegates" ]]
}

# --- No ledger yet: delegation hasn't started, nothing to verify ---
if [[ ! -f "$LEDGER" ]]; then
    echo "✅ No ledger for #${ISSUE} — delegation not started"
    exit 0
fi

# --- Find the last 'complete' entry with verdict 'approved' ---
# Go json.Marshal produces compact JSON, e.g.:
# {"event":"complete","verdict":"approved","role":"architect",...}
LAST_APPROVED=$(grep '"event":"complete"' "$LEDGER" | grep '"verdict":"approved"' | tail -1 || true)

if [[ -z "$LAST_APPROVED" ]]; then
    echo "✅ No approved completion in ledger — handoff not yet required"
    exit 0
fi

# --- Extract role from the last approved-complete entry ---
ROLE=$(echo "$LAST_APPROVED" | grep -o '"role":"[^"]*"' | head -1 | sed 's/"role":"//;s/"$//')

if [[ -z "$ROLE" ]]; then
    echo "✅ Complete entry has no role field — cannot verify handoff"
    exit 0
fi

# --- Leaf roles don't need to dispatch downstream ---
if ! is_non_leaf "$ROLE"; then
    echo "✅ Role '${ROLE}' is a leaf role — handoff not required"
    exit 0
fi

# --- Check for child dispatch events in this issue's ledger ---
# Child dispatches have parent_issue set (parent_issue is omitempty in JSON,
# so its presence indicates a child dispatch was recorded).
CHILD_DISPATCHES=$(grep '"parent_issue":' "$LEDGER" || true)

if [[ -z "$CHILD_DISPATCHES" ]]; then
    # Find what the role delegates to for the error message
    ROLE_FILE=".mill/roles/${ROLE}/ROLE.md"
    EXPECTED=$(awk '
        /^delegates_to:/   { flag=1; next }
        flag && !/^  - /   { exit }
        flag && /^  - /    { sub(/^  - /, ""); print }
    ' "$ROLE_FILE" | tr '\n' ' ')
    echo "❌ BLOCKED: role '${ROLE}' completed (approved) but no child dispatch in ledger" >&2
    echo "   Non-leaf roles must delegate downstream before declaring complete." >&2
    echo "   Run: mill delegate ${ISSUE} --role <successor>" >&2
    echo "   Expected successor(s): ${EXPECTED}" >&2
    exit 1
fi

echo "✅ Role '${ROLE}' dispatched downstream — child dispatch(s) found in ledger"
exit 0
