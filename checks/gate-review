#!/bin/bash
# Gate: REVIEW phase complete — review.md must exist with APPROVED verdict
set -euo pipefail
issue="${1:?usage: $0 <issue-number>}"
review=".mill/phases/${issue}/review.md"
test -f "$review" || { echo "BLOCKED: review.md missing for #${issue}. Spawn Reviewer."; exit 1; }
grep -q 'APPROVED' "$review" || { echo "BLOCKED: review.md does not contain APPROVED verdict"; exit 1; }
echo "REVIEW gate passed for #${issue}"
