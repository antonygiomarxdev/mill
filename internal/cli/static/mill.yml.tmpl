# mill.yml — Project configuration for mill agent delegation harness
# Generated by: mill init

project: {{.Name}}

# AI provider configuration
provider: {{.Provider}}
model: {{.Model}}
max-rounds: {{.MaxRounds}}

# Concurrency control for agent dispatch
concurrency:
  max-slots: 4   # max simultaneous agent dispatches

# Directory layout for project scaffolding
directories:
  roles: roles/
  checks: checks/
  skills: skills/
  docs: docs/

# Role assignments
roles:
  default: roles/sr-dev-be/ROLE.md
