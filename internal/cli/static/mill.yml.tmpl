# mill.yml — Project configuration for mill agent delegation harness
# Generated by: mill init

project: {{.Name}}
type: {{.ProjectType}}

# AI provider configuration
provider: {{.Provider}}
model: {{.Model}}
max-rounds: {{.MaxRounds}}

# Concurrency control for agent dispatch
concurrency:
  max-slots: 4   # max simultaneous agent dispatches

# Recursive delegation — chain of command automation
# Each role delegates down the hierarchy automatically
# view: "result" (final answer only) or "tree" (full delegation tree)
# max_depth: caps the delegation chain length (default 4)
# models: cost tiers — "pro" for thinking roles, "cheap" for execution roles
recursion:
  view: result
  max_depth: 4
  models:
    pro: deepseek/deepseek-v4-pro
    cheap: deepseek/deepseek-v4-flash

# Context compaction — trims old conversation to prevent context-window exhaustion
compact:
  enabled: false   # set to true to auto-compact long sessions
  mode: fast        # compaction strategy (only "fast" currently supported)

# Directory layout for project scaffolding
directories:
  roles: roles/
  checks: checks/
  skills: skills/
  docs: docs/

# Role assignments
roles:
  default: roles/sr-dev-be/ROLE.md
