#!/bin/bash
# Gate: FRD phase complete — frd.md must exist with all sections
set -euo pipefail
issue="${1:?usage: $0 <issue-number>}"
mkdir -p ".mill/phases/${issue}"
frd=".mill/phases/${issue}/frd.md"
test -f "$frd" || { echo "BLOCKED: frd.md missing for #${issue}. Spawn PM."; exit 1; }
for section in "User need" "Functional requirements" "Out of scope" "Priority"; do
  grep -q "## ${section}" "$frd" || { echo "BLOCKED: frd.md missing section '${section}'"; exit 1; }
done
echo "FRD gate passed for #${issue}"
