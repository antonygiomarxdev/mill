#!/bin/bash
# Gate: IMPLEMENT phase complete — coverage must meet threshold
set -euo pipefail
threshold="${COVERAGE_THRESHOLD:-90}"
pkg="${1:-./...}"

output=$(go test -count=1 -cover "$pkg" 2>&1) || { echo "BLOCKED: tests failed"; echo "$output"; exit 1; }

# Extract coverage percentage from "coverage: X.X% of statements"
cov=$(echo "$output" | grep -oP 'coverage: \K[0-9.]+(?=% of statements)' | head -1)
if [ -z "$cov" ]; then
  echo "BLOCKED: could not parse coverage from output"
  echo "$output"
  exit 1
fi

# Compare with bc for floating point
if (( $(echo "$cov < $threshold" | bc -l) )); then
  echo "BLOCKED: coverage ${cov}% below threshold ${threshold}%"
  exit 1
fi

echo "COVERAGE gate passed: ${cov}% ≥ ${threshold}%"
