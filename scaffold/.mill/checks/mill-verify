#!/usr/bin/env bash
# mill-verify — verify a worker's output against its role and the gauntlet.
# The single verification entry point at the dispatch boundary. Invoked by the
# coordinator after worker_done, in the worker's own worktree:
#
#   mill-verify --worktree <path> --role <role> [--files-modified <a,b,c>]
#
# What it checks, in order:
#   1. The gauntlet — build and lint (pre-commit steps) and test (pre-push
#      step). The config is read from the coordinator's Mill root (the repo
#      the checks live in); the commands run inside the worktree, so they
#      check exactly what the worker produced.
#   2. Role capability enforcement — every changed file must be allowed for
#      the dispatched role. The change set is --files-modified when given
#      (the worker_done payload is the authoritative record), otherwise the
#      git diff since the worktree's base commit.
#   3. Nothing may be left uncommitted — a worker whose deliverable is not
#      committed cannot pass.
#
# Exits 0 if clean; 1 naming the failure otherwise. This is not a git hook:
# it is a command the coordinator runs, so it cannot be skipped by a worker.
set -euo pipefail

worktree=""
role=""
files_modified=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --worktree) worktree="${2:-}"; shift 2 ;;
        --role) role="${2:-}"; shift 2 ;;
        --files-modified) files_modified="${2:-}"; shift 2 ;;
        -h|--help)
            echo "usage: mill-verify --worktree <path> --role <role> [--files-modified <a,b,c>]"
            echo "  --worktree <path>       the worker's worktree"
            echo "  --role <role>           the dispatched role (its ROLE.md in .mill/roles/)"
            echo "  --files-modified <list> the worker_done change set; judged instead of the"
            echo "                          git diff since the worktree base commit"
            exit 0
            ;;
        *) echo "error: unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [[ -z "$worktree" || -z "$role" ]]; then
    echo "usage: mill-verify --worktree <path> --role <role> [--files-modified <a,b,c>]" >&2
    exit 2
fi

if [[ ! -d "$worktree" ]]; then
    echo "error: no such worktree: $worktree" >&2
    exit 1
fi

# Resolve the checks' own directory before moving into the worktree: the
# role-capabilities and gauntlet configs are read from the repository the
# checks live in (the coordinator's Mill root), never from the worktree
# being verified. Resolving after `cd "$worktree"` would pick up the
# worktree's copy of these scripts instead.
here="$(cd "$(dirname "$0")" && pwd)"
role_enforce="$here/role-enforce"
if [[ ! -x "$role_enforce" ]]; then
    echo "error: role-enforce not found next to mill-verify" >&2
    exit 1
fi

cd "$worktree" || exit 1

violation=0

# --- 1. The gauntlet: build, lint, test in the worktree ----------------------
# load_gauntlet and run_step live in common.sh beside this script. The config
# is read from the coordinator's Mill root (where the checks live), but
# run_step evaluates the commands in the current cwd — the worktree — so the
# gauntlet checks exactly what the worker produced. With no .mill/gauntlet
# configured, load_gauntlet says so and skips the steps — a project with no
# gauntlet config fails nothing, like the hooks did. Role enforcement below
# is independent and always runs.
# shellcheck source=common.sh
source "$here/common.sh"

load_gauntlet
run_step build
run_step lint
run_step test

# --- 2. Role capability enforcement over the change set ----------------------
# --files-modified is authoritative: it is the exact change set the worker
# reported. Without it, fall back to the git diff since the worktree's base
# commit (its oldest reflog entry — where the worker started).
#
# Entries may carry a git status prefix — a single letter (A, M, D, R) followed
# by whitespace, then the path. Without a prefix — backwards-compatible bare
# paths — the entry is judged as a write exactly as before. Deletions (D) are
# not writes: the role never produced that file, so they are skipped. Renames
# (R) judge the new path and skip the old as a deletion. Anything unrecognised
# is judged as a write — fail closed.
judge_write() {
    if ! "$role_enforce" --test "$role" "$1" >/dev/null 2>&1; then
        echo "error: $1 is not allowed for role '$role'" >&2
        violation=1
    fi
    return 0
}

skip_deleted() {
    echo "mill-verify: skipping deleted path $1 (not a write)" >&2
    return 0
}

if [[ -n "$files_modified" ]]; then
    # Trim spaces around commas: payloads may arrive as "a, b, c".
    entries="$(printf '%s' "$files_modified" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        if [[ "$entry" =~ ^([AMDR])[[:space:]]+(.+) ]]; then
            status="${BASH_REMATCH[1]}"
            rest="${BASH_REMATCH[2]}"
            case "$status" in
                A|M)
                    judge_write "$rest"
                    ;;
                D)
                    skip_deleted "$rest"
                    ;;
                R)
                    old="${rest%%[[:space:]]*}"
                    new="$(printf '%s' "${rest#*[[:space:]]}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
                    if [[ -n "$old" ]]; then
                        skip_deleted "$old"
                    fi
                    if [[ -n "$new" ]]; then
                        judge_write "$new"
                    fi
                    ;;
            esac
        else
            judge_write "$entry"
        fi
    done <<< "$entries"
else
    base="$(git reflog --format=%H | tail -1)"
    if [[ -z "$base" || "$(git cat-file -t "$base" 2>/dev/null)" != "commit" ]]; then
        echo "error: cannot determine worktree base commit (pass --files-modified)" >&2
        exit 1
    fi
    while IFS=$'\t' read -r code path1 path2; do
        [[ -z "$code" ]] && continue
        # Strip the trailing similarity score from the status code (R100 → R, C75 → C).
        letter="${code%%[0-9]*}"
        case "$letter" in
            D)
                skip_deleted "$path1"
                ;;
            R)
                skip_deleted "$path1"
                judge_write "$path2"
                ;;
            *)
                # Additions, modifications, typechanges, copies, and anything
                # else: judge as a write. Fail closed.
                judge_write "$path1"
                if [[ -n "$path2" ]]; then
                    judge_write "$path2"
                fi
                ;;
        esac
    done < <(git diff --name-status "$base" HEAD)
fi

# --- 3. Nothing left uncommitted ---------------------------------------------
uncommitted="$(git status --porcelain)"
if [[ -n "$uncommitted" ]]; then
    echo "error: uncommitted work left in the worktree:" >&2
    echo "$uncommitted" | sed 's/^/  /' >&2
    violation=1
fi

if [[ "$violation" -eq 0 ]]; then
    echo "mill-verify: PASS — role '$role' satisfied, gauntlet clean"
fi
exit "$violation"
