#!/bin/bash
# Mill gauntlet — mutation testing. Runs on land to main.
# Slow (<15min). Fail = merge rejected.
# Ensures tests catch real bugs, not just coverage metrics.
set -euo pipefail

echo "mill: mutation testing"

# go-mutesting is Go-specific. A non-Go project has nothing to mutate with it;
# report that clearly rather than failing on a missing binary.
if [[ ! -f go.mod ]]; then
    echo "mill: mutation-testing: no go.mod — not a Go project, skipping (language-agnostic gauntlet: see .mill/gauntlet)"
    exit 0
fi

go-mutesting ./... 2>&1 | tail -5

# go-mutesting exits non-zero if any mutant survives
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo "FAIL mutation testing — mutants survived. Strengthen your tests."
  exit 1
fi

echo "PASS mutation testing — all mutants killed"
