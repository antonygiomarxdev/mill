#!/usr/bin/env bash
# mill-preflight — refuse to dispatch when Mill cannot.
# Called by the coordinator before any dispatch. Exits non-zero with an
# actionable message when Orca's runtime is unreachable or the working
# directory is not a Mill project.
set -euo pipefail

# 1. Orca must be reachable
if ! orca status 2>/dev/null | grep -q "runtimeReachable: true"; then
    echo "error: Orca is not running. Run 'orca open' first." >&2
    exit 1
fi

# 2. Must be in a Mill project
if [[ ! -d .mill/roles ]]; then
    echo "error: Not a Mill project (no .mill/roles/)." >&2
    exit 1
fi

exit 0
