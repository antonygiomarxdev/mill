#!/usr/bin/env bash
# role-enforce — pre-commit capability enforcement.
# Usage:
#   checks/role-enforce              — git pre-commit hook
#   checks/role-enforce --test <role> <file>  — test mode
#
# Exits 0 if allowed, 1 if blocked, 2 on usage error.

set -euo pipefail

ROLES_DIR=".mill/roles"
CAPABILITIES_FILE=".mill/role-capabilities"

# --- helpers ----------------------------------------------------------------

# parse_list extracts a YAML list field from ROLE.md frontmatter.
# Args: field_name file_path → space-separated values (or empty string).
parse_list() {
    local field="$1" file="$2"
    awk -v field="$field" '
      $0 ~ "^" field ":" {
        gsub("^" field ": *", "")
        gsub(/[\[\]]/, "")
        gsub(/,/, " ")
        if ($0 != "") { print $0 }
        else { flag=1; next }
      }
      flag && !/^  - /    { exit }
      flag && /^  - /     { gsub(/^  - /, ""); print }
    ' "$file" | xargs 2>/dev/null
}

# resolve_categories maps a role's allowed_files categories to the project's
# file patterns via .mill/role-capabilities (same shape as .mill/gauntlet:
# plain bash, sourced). An unmapped category or a missing capabilities file
# fails closed — it blocks, never allows.
resolve_categories() {
    local role="$1" role_md="$2"

    # Parse the role's declared categories (e.g. code, docs, config).
    local categories
    categories=$(parse_list "allowed_files" "$role_md")
    if [[ -z "$categories" ]]; then
        echo "pre-commit: BLOCKED — role '$role' has no file permissions." >&2
        echo "  $role has an empty allowed_files list." >&2
        echo "  To proceed: switch roles with 'mill role set' or escalate to Staff." >&2
        exit 1
    fi

    # Load the project's category → pattern map.
    local top
    top=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
    local cfg="$top/$CAPABILITIES_FILE"
    if [[ ! -f "$cfg" ]]; then
        echo "pre-commit: BLOCKED — role '$role' cannot commit: no $CAPABILITIES_FILE." >&2
        echo "  Role '$role' may write: $categories" >&2
        echo "  Map those categories to file patterns in .mill/role-capabilities" >&2
        echo "  (copy the example from .mill/role-capabilities.example)." >&2
        echo "  To proceed: switch roles with 'mill role set' or escalate to Staff." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$cfg"

    # Expand categories into patterns; unmapped categories block.
    local expanded="" missing=""
    local c
    for c in $categories; do
        local patterns
        patterns="${!c:-}"
        if [[ -z "$patterns" ]]; then
            missing="$missing $c"
            continue
        fi
        expanded="$expanded $patterns"
    done
    if [[ -n "$missing" ]]; then
        echo "pre-commit: BLOCKED — role '$role' declares categories not in $CAPABILITIES_FILE:$missing" >&2
        echo "  Add the missing category or edit the role's allowed_files." >&2
        echo "  To proceed: switch roles with 'mill role set' or escalate to Staff." >&2
        exit 1
    fi

    echo "$expanded" | xargs
}

# check_forbidden returns 0 if the file basename is NOT forbidden.
# Args: filename forbidden_patterns
check_forbidden() {
    local file="$1" forbidden="$2"
    local basename
    basename=$(basename "$file")

    if [[ -z "$forbidden" ]]; then
        return 0
    fi

    for p in $forbidden; do
        if [[ "$basename" == "$p" ]]; then
            return 1
        fi
    done

    return 0
}

# enforce_file checks a single file against role capabilities.
# Args: role role_md_path file_path → exits on first violation.
enforce_file() {
    local role="$1" role_md="$2" file="$3"

    # Parse frontmatter fields
    local allowed forbidden
    allowed=$(parse_list "allowed_files" "$role_md")
    forbidden=$(parse_list "forbidden_patterns" "$role_md")

    # 1. Check forbidden patterns first (takes precedence)
    if ! check_forbidden "$file" "$forbidden"; then
        local basename
        basename=$(basename "$file")
        echo "pre-commit: BLOCKED — role '$role' cannot modify $basename (forbidden)." >&2
        exit 1
    fi

    # 2. Resolve the role's categories to the project's file patterns
    allowed=$(resolve_categories "$role" "$role_md")

    # 3. Check extension against the resolved patterns
    local ext ext_lc
    ext=".${file##*.}"
    ext_lc=$(echo "$ext" | tr '[:upper:]' '[:lower:]')

    for a in $allowed; do
        if [[ "$a" == "$ext_lc" ]]; then
            return 0
        fi
    done

    # Not allowed
    local allowed_list
    allowed_list=$(echo "$allowed" | tr ' ' ', ')
    echo "pre-commit: BLOCKED — role '$role' cannot commit $ext_lc files." >&2
    echo "  $role can produce: $allowed_list" >&2
    echo "  To proceed: switch roles with 'mill role set' or escalate to Staff." >&2
    exit 1
}

# --- test mode --------------------------------------------------------------
if [[ "${1:-}" == "--test" ]]; then
    ROLE="${2:-}"
    FILE="${3:-}"
    if [[ -z "$ROLE" || -z "$FILE" ]]; then
        echo "Usage: $0 --test <role> <file>" >&2
        exit 2
    fi

    ROLE_MD="$ROLES_DIR/$ROLE/ROLE.md"
    if [[ ! -f "$ROLE_MD" ]]; then
        echo "role-enforce: unknown role '$ROLE' (no $ROLE_MD)" >&2
        exit 2
    fi

    enforce_file "$ROLE" "$ROLE_MD" "$FILE"
    exit 0
fi

# --- pre-commit mode --------------------------------------------------------
# Check for --no-verify
for arg in "$@"; do
    if [[ "$arg" == "--no-verify" ]]; then
        exit 0
    fi
done

# Read active role
MILL_DIR=".mill"
ROLE_STATE="$MILL_DIR/role"
if [[ ! -f "$ROLE_STATE" ]]; then
    exit 0
fi

ROLE=$(tr -d '[:space:]' < "$ROLE_STATE")
if [[ -z "$ROLE" ]]; then
    exit 0
fi

ROLE_MD="$ROLES_DIR/$ROLE/ROLE.md"
if [[ ! -f "$ROLE_MD" ]]; then
    echo "role-enforce: WARNING — no role definition for '$ROLE' at $ROLE_MD" >&2
    exit 0
fi

# Get staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [[ -z "$STAGED" ]]; then
    exit 0
fi

# Check each staged file
BLOCKED_FILES=""
FIRST_BLOCKED_REASON=""
while IFS= read -r f; do
    [[ -z "$f" ]] && continue

    # Run enforcement as subshell to capture violation without exiting main loop
    if ! enforce_file "$ROLE" "$ROLE_MD" "$f"; then
        # enforce_file already printed the error; capture via subshell result
        if [[ -z "$BLOCKED_FILES" ]]; then
            BLOCKED_FILES="$f"
        else
            BLOCKED_FILES="$BLOCKED_FILES $f"
        fi
    fi
done <<< "$STAGED"

if [[ -n "$BLOCKED_FILES" ]]; then
    # Log enforcement
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$MILL_DIR"
    echo "[$TIMESTAMP] BLOCKED $ROLE $BLOCKED_FILES" >> "$MILL_DIR/enforcement.log"

    # Re-run enforcement on first file to get the error message (it exits 1)
    FIRST=$(echo "$BLOCKED_FILES" | cut -d' ' -f1)
    enforce_file "$ROLE" "$ROLE_MD" "$FIRST"
    exit 1
fi

exit 0
